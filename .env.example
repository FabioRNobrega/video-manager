# Optional: absolute path on the Docker host to the PereneArchive root.
# Defaults to /home/PereneArchive when unset, so most operators need no .env at all.
VIDEO_ROOT=/home/PereneArchive

# Expected layout under VIDEO_ROOT (created by the app if the host path is writable):
#   VIDEO_ROOT/Videos
#   VIDEO_ROOT/Pictures
#   VIDEO_ROOT/Music
#   VIDEO_ROOT/Documents
#   VIDEO_ROOT/Books
#   VIDEO_ROOT/Downloads
#   VIDEO_ROOT/Shared
#   VIDEO_ROOT/Family
#   VIDEO_ROOT/History
#   VIDEO_ROOT/Trash
#   VIDEO_ROOT/Videos/Cuts                - exported A/B cuts
#   VIDEO_ROOT/Videos/VideoComposition    - composed videos

# Optional: loopback port used to open the application.
WEBAPP_PORT=8080
