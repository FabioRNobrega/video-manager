# Optional: absolute path on the Docker host to the PereneArchive root.
# Defaults to /home/PereneArchive when unset, so most operators need no .env at all.
VIDEO_ROOT=/home/PereneArchive

# Expected layout under VIDEO_ROOT (populated by the operator before first run):
#   VIDEO_ROOT/Videos                     - the read-only video library
#   VIDEO_ROOT/Videos/Cuts                - read-write exported A/B cuts
#   VIDEO_ROOT/Videos/VideoComposition    - read-write composed videos

# Optional: loopback port used to open the application.
WEBAPP_PORT=8080
