@inherits LayoutComponentBase

<div class="page">
    <a class="visually-hidden-focusable skip-link" href="#main-content">Skip to main content</a>
    <header class="app-header"><NavMenu /></header>
    <main id="main-content" class="app-main">@Body</main>
</div>

<div id="blazor-error-ui" class="alert alert-warning rounded-0 mb-0" role="alert" data-nosnippet>
    <strong>Something went wrong.</strong>
    <a href="." class="alert-link reload">Reload Perene Tech Videos</a>
    <button type="button" class="btn-close dismiss" aria-label="Dismiss error"></button>
</div>
