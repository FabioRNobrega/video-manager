@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<section class="card overflow-hidden text-document-editor d-flex flex-column h-100" aria-label="Document editor">
    <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
        <div class="d-flex align-items-center gap-2 min-w-0">
            <button class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center justify-content-center"
                    style="width:40px;height:40px;"
                    type="button"
                    disabled="@_busy"
                    aria-label="Back to listing"
                    @onclick="BackAsync">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
            </button>
            <span class="fw-semibold text-truncate" title="@_name">@_name</span>
            <span class="badge text-bg-secondary text-uppercase">@KindLabel</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="small text-body-secondary" role="status" aria-live="polite">@StatusText</span>
            @if (_conflict)
            {
                <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@_busy" @onclick="CopyDraftAsync">
                    <i class="bi bi-clipboard me-1" aria-hidden="true"></i>Copy draft
                </button>
                <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@_busy" @onclick="ReloadAsync">
                    <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Reload
                </button>
            }
            <button class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1"
                    type="button"
                    disabled="@(_busy || !_dirty || _conflict)"
                    @onclick="SaveAsync">
                <i class="bi bi-save" aria-hidden="true"></i>
                Save
            </button>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger m-3" role="alert">@_error</div>
    }

    @if (_loading)
    {
        <div class="card-body d-flex flex-fill flex-column align-items-center justify-content-center gap-2 text-center text-body-secondary" role="status" aria-live="polite">
            <span class="spinner-border text-primary" aria-hidden="true"></span>
            <strong class="fs-5 text-body">Loading @_name</strong>
        </div>
    }
    else
    {
        <div class="d-flex flex-column flex-lg-row flex-fill text-document-editor-panes">
            <div class="text-document-pane border-bottom border-lg-bottom-0 border-lg-end">
                <label class="visually-hidden" for="@SourceId">Document source</label>
                <textarea @ref="_sourceElement"
                          id="@SourceId"
                          class="form-control text-document-source"
                          spellcheck="false"
                          disabled="@(_busy || _conflict)"
                          value="@_source"
                          @oninput="HandleSourceChanged"></textarea>
            </div>
            <div class="text-document-pane">
                <div class="text-document-preview p-3" aria-label="Preview">
                    @((MarkupString)_previewHtml)
                </div>
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ItemId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }

    private string _name = string.Empty;
    private TextDocumentKind _documentKind;
    private string _source = string.Empty;
    private string _originalSource = string.Empty;
    private string _revision = string.Empty;
    private string _previewHtml = string.Empty;
    private bool _loading = true;
    private bool _busy;
    private bool _saving;
    private bool _conflict;
    private string? _error;
    private ElementReference _sourceElement;
    private IJSObjectReference? _module;
    private DotNetObjectReference<TextDocumentEditor>? _dotNetReference;
    private CancellationTokenSource? _previewCts;
    private bool _shortcutRegistered;

    private bool _dirty => !string.Equals(_source, _originalSource, StringComparison.Ordinal);
    private string SourceId => $"text-document-source-{ItemId}";
    private string KindLabel => _documentKind == TextDocumentKind.Markdown ? "Markdown" : "Text";

    private string StatusText
    {
        get
        {
            if (_conflict)
            {
                return "Conflict: reload or copy your draft.";
            }

            if (_saving)
            {
                return "Saving...";
            }

            return _dirty ? "Unsaved changes" : "Saved";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/textDocumentEditor.js");
            }
            catch (JSException)
            {
            }
        }

        if (_module is null || _shortcutRegistered || _loading)
        {
            return;
        }

        try
        {
            _shortcutRegistered = true;
            _dotNetReference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerSaveShortcut", _sourceElement, _dotNetReference);
        }
        catch (JSException)
        {
            _shortcutRegistered = false;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _shortcutRegistered = false;
        _error = null;
        _conflict = false;
        try
        {
            var url = $"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/text";
            var document = await Http.GetFromJsonAsync<TextDocumentDto>(url);
            if (document is null)
            {
                _error = "The document could not be loaded.";
                return;
            }

            _name = document.Name;
            _documentKind = document.DocumentKind;
            _source = document.Source;
            _originalSource = document.Source;
            _revision = document.Revision;
            _previewHtml = document.PreviewHtml;
        }
        catch (HttpRequestException)
        {
            _error = "The document could not be loaded.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleSourceChanged(ChangeEventArgs args)
    {
        _source = args.Value?.ToString() ?? string.Empty;
        SchedulePreview();
    }

    private void SchedulePreview()
    {
        _previewCts?.Cancel();
        _previewCts?.Dispose();
        var cts = new CancellationTokenSource();
        _previewCts = cts;
        _ = RunPreviewAfterDelayAsync(_source, cts);
    }

    private async Task RunPreviewAfterDelayAsync(string source, CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        try
        {
            var url = $"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/text/preview";
            using var response = await Http.PostAsJsonAsync(url, new TextDocumentPreviewRequest(source), cts.Token);
            if (cts.IsCancellationRequested || !response.IsSuccessStatusCode)
            {
                return;
            }

            var preview = await response.Content.ReadFromJsonAsync<TextDocumentPreviewDto>(cancellationToken: cts.Token);
            if (preview is null || cts.IsCancellationRequested)
            {
                return;
            }

            _previewHtml = preview.PreviewHtml;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
        catch (HttpRequestException)
        {
        }
    }

    [JSInvokable]
    public async Task OnSaveShortcut() => await SaveAsync();

    [JSInvokable]
    public async Task OnEscapeShortcut()
    {
        if (_busy)
        {
            return;
        }

        if (_dirty && !_conflict)
        {
            await SaveAsync();
            if (_conflict || _error is not null)
            {
                return;
            }
        }

        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_busy || !_dirty || _conflict)
        {
            return;
        }

        _busy = true;
        _saving = true;
        _error = null;
        StateHasChanged();
        try
        {
            var url = $"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/text";
            using var response = await Http.PutAsJsonAsync(url, new TextDocumentSaveRequest(_source, _revision));
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _conflict = true;
                _error = "This document changed outside the editor. Reload the current version or copy your draft first.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _error = "The document could not be saved.";
                return;
            }

            var document = await response.Content.ReadFromJsonAsync<TextDocumentDto>();
            if (document is not null)
            {
                _originalSource = document.Source;
                _source = document.Source;
                _revision = document.Revision;
                _previewHtml = document.PreviewHtml;
            }
        }
        catch (HttpRequestException)
        {
            _error = "The document could not reach the server.";
        }
        finally
        {
            _busy = false;
            _saving = false;
            // Ctrl+S reaches this method via a [JSInvokable] call from JS, which bypasses Blazor's
            // automatic post-event re-render (that only happens for @onclick/@oninput-style handlers),
            // so without this the UI stays stuck showing "Saving..." until something else re-renders it.
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            await LoadAsync();
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CopyDraftAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("copyToClipboard", _source);
        }
        catch (JSException)
        {
        }
    }

    private async Task BackAsync()
    {
        if (_dirty && !_conflict)
        {
            var confirmed = await ConfirmDiscardAsync();
            if (!confirmed)
            {
                return;
            }
        }

        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private async Task<bool> ConfirmDiscardAsync()
    {
        if (_module is null)
        {
            return true;
        }

        try
        {
            return await _module.InvokeAsync<bool>("confirmDiscard", "Leave without saving your changes?");
        }
        catch (JSException)
        {
            return true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _previewCts?.Cancel();
        _previewCts?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregisterSaveShortcut", _sourceElement);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }

        _dotNetReference?.Dispose();
    }
}
