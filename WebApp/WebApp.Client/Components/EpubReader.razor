@implements IAsyncDisposable
@using System.Globalization
@inject HttpClient Http
@inject IJSRuntime JS

<section class="epub-reader card position-fixed top-0 start-0 w-100 h-100 overflow-hidden border-0 rounded-0 d-flex flex-column @(_isDarkReaderMode ? "reader-dark" : "reader-light")"
         aria-label="Book reader">
    @if (_isToolbarCollapsed)
    {
        <button class="btn btn-outline-secondary epub-reader-toolbar-show-button d-inline-flex align-items-center justify-content-center p-2"
                type="button"
                aria-label="Show reader toolbar"
                title="Show reader toolbar"
                @onclick="ShowToolbar">
            <i class="bi bi-arrow-bar-down" aria-hidden="true"></i>
        </button>
    }

    <div class="epub-reader-toolbars @(_isToolbarCollapsed ? "d-none" : "")">
        <header class="epub-reader-toolbar bg-body-tertiary border-bottom d-flex flex-wrap align-items-center gap-2 p-2">
            <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2"
                    type="button"
                    aria-label="@(_showToc ? "Hide table of contents" : "Show table of contents")"
                    title="Table of contents"
                    aria-pressed="@_showToc"
                    @onclick="ToggleToc">
                <i class="bi bi-list-ul" aria-hidden="true"></i>
            </button>

            <div class="btn-group" role="group" aria-label="Chapter navigation">
                <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2"
                        type="button"
                        disabled="@(_chapter?.PreviousChapterId is null || _isLoadingChapter)"
                        aria-label="Previous chapter"
                        title="Previous chapter"
                        @onclick="GoToPreviousChapterAsync">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
                <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2"
                        type="button"
                        disabled="@(_chapter?.NextChapterId is null || _isLoadingChapter)"
                        aria-label="Next chapter"
                        title="Next chapter"
                        @onclick="GoToNextChapterAsync">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            </div>

            <span class="fw-semibold text-truncate flex-grow-1 min-w-0" title="@(_book?.Title)">
                @(_book?.Title ?? "Book")
            </span>

            <div class="btn-group" role="group" aria-label="Font size">
                <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2"
                        type="button"
                        disabled="@(_fontSizeIndex <= 0)"
                        aria-label="Decrease text size"
                        title="Decrease text size"
                        @onclick="DecreaseFontSize">
                    <i class="bi bi-dash-lg" aria-hidden="true"></i>
                </button>
                <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2"
                        type="button"
                        disabled="@(_fontSizeIndex >= FontSizesPx.Length - 1)"
                        aria-label="Increase text size"
                        title="Increase text size"
                        @onclick="IncreaseFontSize">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                </button>
            </div>

            <label class="visually-hidden" for="epub-reader-font-family">Font family</label>
            <select id="epub-reader-font-family" class="form-select form-select-sm w-auto" value="@_fontFamily" @onchange="OnFontFamilyChanged">
                @foreach (var font in FontFamilyKeys)
                {
                    <option value="@font">@font</option>
                }
            </select>

            <label class="visually-hidden" for="epub-reader-line-height">Line spacing</label>
            <select id="epub-reader-line-height" class="form-select form-select-sm w-auto" value="@_lineHeightIndex" @onchange="OnLineHeightChanged">
                @for (var index = 0; index < LineHeights.Length; index++)
                {
                    <option value="@index">@LineHeights[index].Label</option>
                }
            </select>

            <div class="btn-group" role="group" aria-label="Text width">
                <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2"
                        type="button"
                        disabled="@(_contentPaddingPercent >= MaxContentPaddingPercent)"
                        aria-label="Decrease text width"
                        title="Decrease text width"
                        @onclick="DecreaseTextWidth">
                    <i class="bi bi-dash-lg" aria-hidden="true"></i>
                </button>
                <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2"
                        type="button"
                        disabled="@(_contentPaddingPercent <= MinContentPaddingPercent)"
                        aria-label="Increase text width"
                        title="Increase text width"
                        @onclick="IncreaseTextWidth">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                </button>
            </div>

            <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2"
                    type="button"
                    aria-label="@(_isDarkReaderMode ? "Switch to light reading mode" : "Switch to dark reading mode")"
                    title="@(_isDarkReaderMode ? "Light reading mode" : "Dark reading mode")"
                    aria-pressed="@_isDarkReaderMode"
                    @onclick="ToggleReaderMode">
                <i class="bi @(_isDarkReaderMode ? "bi-brightness-high" : "bi-moon-stars")" aria-hidden="true"></i>
            </button>

            <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2"
                    type="button"
                    aria-label="Close book"
                    title="Close book"
                    @onclick="CloseAsync">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </header>

        <div class="epub-reader-toolbar bg-body-tertiary border-bottom d-flex flex-wrap align-items-center gap-2 p-2" role="toolbar" aria-label="Selection actions">
            <button class="btn btn-primary d-inline-flex align-items-center gap-2"
                    type="button"
                    disabled="@(string.IsNullOrWhiteSpace(_selectedText) || _isSavingNote)"
                    @onclick="SaveNoteAsync">
                @if (_isSavingNote)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-bookmark-star" aria-hidden="true"></i>
                }
                Save Note
            </button>
            <button class="btn btn-outline-secondary d-inline-flex align-items-center gap-2"
                    type="button"
                    disabled="@string.IsNullOrWhiteSpace(_selectedText)"
                    @onclick="CopySelectionAsync">
                <i class="bi bi-clipboard" aria-hidden="true"></i>
                Copy Selection
            </button>
            @if (_statusMessage is not null)
            {
                <span class="small text-body-secondary" role="status" aria-live="polite">@_statusMessage</span>
            }
            <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center p-2 ms-auto"
                    type="button"
                    aria-label="Hide reader toolbar"
                    title="Hide reader toolbar"
                    @onclick="HideToolbar">
                <i class="bi bi-arrow-bar-up" aria-hidden="true"></i>
            </button>
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger m-3 mb-0" role="alert">@_error</div>
        }
    </div>

    <div class="epub-reader-body flex-grow-1 d-flex overflow-hidden">
        @if (_showToc)
        {
            <nav class="epub-reader-toc border-end p-3 overflow-auto" aria-label="Table of contents">
                @if (_book is null)
                {
                    <p class="small text-body-secondary mb-0">Loading contents…</p>
                }
                else if (_book.Navigation.Count == 0)
                {
                    <p class="small text-body-secondary mb-0">No table of contents available.</p>
                }
                else
                {
                    @RenderNavItems(_book.Navigation)
                }
            </nav>
        }

        <div class="epub-reader-page-frame flex-grow-1 overflow-hidden" style="@PageFrameStyle">
            <div class="epub-reader-content h-100 overflow-hidden"
                 style="@ContentStyle"
                 @ref="_contentRef"
                 tabindex="0"
                 @onmouseup="HandleSelectionChangedAsync"
                 @onkeyup="HandleSelectionChangedAsync"
                 @onkeydown="HandleContentKeyDownAsync">
                @if (_isLoadingBook || _isLoadingChapter)
                {
                    <div class="d-flex flex-column align-items-center gap-2 py-5 text-center text-body-secondary h-100 justify-content-center" role="status" aria-live="polite">
                        <span class="spinner-border text-primary" aria-hidden="true"></span>
                        <strong>Loading…</strong>
                    </div>
                }
                else if (_chapter is not null)
                {
                    <article class="epub-chapter">
                        @((MarkupString)_chapter.ContentHtml)
                    </article>
                }
            </div>
            @if (_chapter is not null && !_isLoadingBook && !_isLoadingChapter)
            {
                <footer class="epub-reader-progress-footer border-top d-flex flex-wrap align-items-center justify-content-between gap-2 pt-3 pb-2"
                        aria-label="Reading progress and page navigation">
                    <span class="small fw-semibold text-body-secondary epub-reader-progress-value ms-4">
                    Book Progress @FormatPercent(BookProgress)
                    </span>

                    <div class="btn-group epub-reader-page-controls" role="group" aria-label="Page navigation">
                        <button class="btn btn-secondary d-inline-flex align-items-center gap-2"
                                type="button"
                                disabled="@(_pageIndex <= 0 && _chapter.PreviousChapterId is null)"
                                @onclick="GoToPreviousPageAsync">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                            Previous
                        </button>
                        <button class="btn btn-secondary d-inline-flex align-items-center gap-2"
                                type="button"
                                disabled="@(_pageIndex >= _pageCount - 1 && _chapter.NextChapterId is null)"
                                @onclick="GoToNextPageAsync">
                            Next
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </button>
                    </div>

                    <span class="small fw-semibold text-body-secondary text-end epub-reader-progress-value me-4">
                        Chapter Progress @FormatPercent(CurrentChapterProgress)
                    </span>
                </footer>
            }
        </div>
    </div>
</section>

@code {
    private enum PageIntent { First, Last, Fraction, WordOffset }

    private static readonly int[] FontSizesPx = [14, 16, 18, 20, 22, 24, 28];

    private static readonly IReadOnlyDictionary<string, string> FontFamilyStacks = new Dictionary<string, string>
    {
        ["Montserrat"] = "'Montserrat', sans-serif",
        ["Arial"] = "Arial, Helvetica, sans-serif",
        ["Times New Roman"] = "'Times New Roman', Times, serif"
    };

    private static readonly IReadOnlyList<string> FontFamilyKeys = FontFamilyStacks.Keys.ToList();

    private static readonly (string Label, double Value)[] LineHeights =
    [
        ("Compact", 1.4),
        ("Normal", 1.75),
        ("Relaxed", 2.0),
        ("Loose", 2.4)
    ];

    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ItemId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }

    private BookDto? _book;
    private BookChapterDto? _chapter;
    private bool _isLoadingBook;
    private bool _isLoadingChapter;
    private bool _isSavingNote;
    private bool _showToc;
    private bool _isToolbarCollapsed;
    private bool _isDarkReaderMode;
    private int _fontSizeIndex = 2;
    private string _fontFamily = "Montserrat";
    private int _lineHeightIndex = 1;
    private const int MinContentPaddingPercent = 5;
    private const int MaxContentPaddingPercent = 30;
    private const int ContentPaddingStepPercent = 5;
    private const int DesktopDefaultContentPaddingPercent = 25;

    private int _contentPaddingPercent = DesktopDefaultContentPaddingPercent;
    private string? _error;
    private string? _statusMessage;
    private string _selectedText = string.Empty;
    private string? _loadedItemId;
    private ElementReference _contentRef;
    private IJSObjectReference? _module;
    private CancellationTokenSource? _statusCts;

    private bool _pendingPaginationApply;
    private bool _contentPaddingDefaultPending;
    private PageIntent _pendingPageIntent = PageIntent.First;
    private double? _pendingPageFraction;
    private int _pageIndex;
    private int _pageCount = 1;
    private int _currentWordOffset;

    private string ContentStyle => FormattableString.Invariant(
        $"font-size: {FontSizesPx[_fontSizeIndex]}px; font-family: {FontFamilyStacks[_fontFamily]}; line-height: {LineHeights[_lineHeightIndex].Value};");

    private string PageFrameStyle => FormattableString.Invariant($"--epub-reader-inline-padding: {_contentPaddingPercent}%;");

    private int CurrentChapterWordCount => _chapter?.WordCount ?? 0;

    private int WordsBeforeCurrentChapter
    {
        get
        {
            if (_book is null || _chapter is null)
            {
                return 0;
            }

            return _book.Chapters
                .Where(chapter => chapter.ChapterIndex < _chapter.ChapterIndex)
                .Sum(chapter => chapter.WordCount);
        }
    }

    private int BookWordPosition => WordsBeforeCurrentChapter + _currentWordOffset;

    private double CurrentChapterProgress => CurrentChapterWordCount <= 0
        ? 0
        : Math.Clamp((double)_currentWordOffset / CurrentChapterWordCount, 0, 1);

    private double BookProgress => _book?.TotalWordCount is > 0
        ? Math.Clamp((double)BookWordPosition / _book.TotalWordCount, 0, 1)
        : 0;

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedItemId, ItemId, StringComparison.Ordinal))
        {
            return;
        }

        _loadedItemId = ItemId;
        ResetState();
        await SyncReaderModeWithAppThemeAsync();
        await LoadBookAsync();
    }

    private async Task SyncReaderModeWithAppThemeAsync()
    {
        try
        {
            var theme = await JS.InvokeAsync<string>("videoManagerTheme.getTheme");
            _isDarkReaderMode = string.Equals(theme, "dark", StringComparison.Ordinal);
        }
        catch (JSException)
        {
            _isDarkReaderMode = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ebookReader.js");
            if (await ApplyResponsiveContentPaddingDefaultAsync())
            {
                StateHasChanged();
                return;
            }
        }

        if (_module is not null && _pendingPaginationApply && _chapter is not null && !_isLoadingChapter)
        {
            _pendingPaginationApply = false;
            await ApplyPaginationAsync();
        }
    }

    private void ResetState()
    {
        _book = null;
        _chapter = null;
        _error = null;
        _statusMessage = null;
        _selectedText = string.Empty;
        _isToolbarCollapsed = false;
        _fontSizeIndex = 2;
        _fontFamily = "Montserrat";
        _lineHeightIndex = 1;
        _contentPaddingPercent = DesktopDefaultContentPaddingPercent;
        _contentPaddingDefaultPending = true;
        _pageIndex = 0;
        _pageCount = 1;
        _currentWordOffset = 0;
    }

    private async Task<bool> ApplyResponsiveContentPaddingDefaultAsync()
    {
        if (_module is null || !_contentPaddingDefaultPending)
        {
            return false;
        }

        var previousPadding = _contentPaddingPercent;
        try
        {
            _contentPaddingPercent = await _module.InvokeAsync<int>("getDefaultContentPaddingPercent");
        }
        catch (JSException)
        {
            _contentPaddingPercent = DesktopDefaultContentPaddingPercent;
        }
        finally
        {
            _contentPaddingDefaultPending = false;
        }

        return _contentPaddingPercent != previousPadding;
    }

    private async Task LoadBookAsync()
    {
        _isLoadingBook = true;
        _error = null;
        try
        {
            var url = $"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/book";
            var book = await Http.GetFromJsonAsync<BookDto>(url);
            if (book is null)
            {
                _error = "This book could not be opened.";
                return;
            }

            _book = book;
            var initialChapterId = book.Progress?.ChapterId ?? book.ChapterIds.FirstOrDefault();
            if (initialChapterId is null)
            {
                _error = "This book has no readable chapters.";
                return;
            }

            if (book.Progress is { } progress)
            {
                _currentWordOffset = Math.Max(0, progress.WordOffset);
                await LoadChapterAsync(initialChapterId, saveProgressForPrevious: false, PageIntent.WordOffset);
            }
            else
            {
                await LoadChapterAsync(initialChapterId, saveProgressForPrevious: false);
            }
        }
        catch (HttpRequestException)
        {
            _error = "This book could not be reached.";
        }
        finally
        {
            _isLoadingBook = false;
        }
    }

    private async Task LoadChapterAsync(
        string chapterId,
        bool saveProgressForPrevious = true,
        PageIntent intent = PageIntent.First,
        double? fraction = null)
    {
        if (saveProgressForPrevious)
        {
            await SaveProgressAsync();
        }

        _isLoadingChapter = true;
        _error = null;
        StateHasChanged();
        try
        {
            var url = $"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/book/chapters/{Uri.EscapeDataString(chapterId)}";
            var chapter = await Http.GetFromJsonAsync<BookChapterDto>(url);
            if (chapter is null)
            {
                _error = "This chapter could not be loaded.";
                return;
            }

            _chapter = chapter;
            _selectedText = string.Empty;
            _pageIndex = 0;
            _pageCount = 1;
            _currentWordOffset = intent switch
            {
                PageIntent.Last => chapter.WordCount,
                PageIntent.WordOffset => Math.Clamp(_currentWordOffset, 0, chapter.WordCount),
                PageIntent.Fraction when fraction is { } pageFraction => (int)Math.Round(Math.Clamp(pageFraction, 0, 1) * chapter.WordCount),
                _ => 0
            };
            _pendingPageIntent = intent;
            _pendingPageFraction = fraction;
            _pendingPaginationApply = true;
        }
        catch (HttpRequestException)
        {
            _error = "This chapter could not be reached.";
        }
        finally
        {
            _isLoadingChapter = false;
        }
    }

    private Task GoToPreviousChapterAsync() =>
        _chapter?.PreviousChapterId is { } previousId ? JumpToChapterAsync(previousId) : Task.CompletedTask;

    private Task GoToNextChapterAsync() =>
        _chapter?.NextChapterId is { } nextId ? JumpToChapterAsync(nextId) : Task.CompletedTask;

    private async Task JumpToChapterAsync(string chapterId)
    {
        if (_isLoadingChapter || string.Equals(_chapter?.ChapterId, chapterId, StringComparison.Ordinal))
        {
            return;
        }

        await LoadChapterAsync(chapterId);
    }

    private bool IsCurrentChapter(string? chapterId) =>
        chapterId is not null && string.Equals(_chapter?.ChapterId, chapterId, StringComparison.Ordinal);

    private void ToggleToc()
    {
        _showToc = !_showToc;
        RequestPaginationReflow();
    }

    private void HideToolbar()
    {
        _isToolbarCollapsed = true;
        RequestPaginationReflow();
    }

    private void ShowToolbar()
    {
        _isToolbarCollapsed = false;
        RequestPaginationReflow();
    }

    private void ToggleReaderMode() => _isDarkReaderMode = !_isDarkReaderMode;

    private void DecreaseTextWidth()
    {
        if (_contentPaddingPercent < MaxContentPaddingPercent)
        {
            _contentPaddingPercent = Math.Min(MaxContentPaddingPercent, _contentPaddingPercent + ContentPaddingStepPercent);
            RequestPaginationReflow();
        }
    }

    private void IncreaseTextWidth()
    {
        if (_contentPaddingPercent > MinContentPaddingPercent)
        {
            _contentPaddingPercent = Math.Max(MinContentPaddingPercent, _contentPaddingPercent - ContentPaddingStepPercent);
            RequestPaginationReflow();
        }
    }

    private void DecreaseFontSize()
    {
        if (_fontSizeIndex > 0)
        {
            _fontSizeIndex--;
            RequestPaginationReflow();
        }
    }

    private void IncreaseFontSize()
    {
        if (_fontSizeIndex < FontSizesPx.Length - 1)
        {
            _fontSizeIndex++;
            RequestPaginationReflow();
        }
    }

    private void OnFontFamilyChanged(ChangeEventArgs args)
    {
        if (args.Value?.ToString() is { } value && FontFamilyStacks.ContainsKey(value))
        {
            _fontFamily = value;
            RequestPaginationReflow();
        }
    }

    private void OnLineHeightChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var index) && index >= 0 && index < LineHeights.Length)
        {
            _lineHeightIndex = index;
            RequestPaginationReflow();
        }
    }

    private void RequestPaginationReflow()
    {
        if (_chapter is null)
        {
            return;
        }

        _pendingPageIntent = PageIntent.Fraction;
        _pendingPageFraction = _pageCount > 1 ? (double)_pageIndex / (_pageCount - 1) : 0;
        _pendingPaginationApply = true;
    }

    private async Task ApplyPaginationAsync()
    {
        if (_module is null || _chapter is null)
        {
            return;
        }

        try
        {
            _pageCount = Math.Max(1, await _module.InvokeAsync<int>("measurePagination", _contentRef));

            switch (_pendingPageIntent)
            {
                case PageIntent.Fraction when _pendingPageFraction is { } fraction:
                    var targetIndex = (int)Math.Round(fraction * Math.Max(0, _pageCount - 1));
                    await SetPageIndexAsync(targetIndex);
                    break;
                case PageIntent.WordOffset:
                    var wordFraction = CurrentChapterWordCount > 0
                        ? (double)_currentWordOffset / CurrentChapterWordCount
                        : 0;
                    var wordTargetIndex = (int)Math.Round(wordFraction * Math.Max(0, _pageCount - 1));
                    await SetPageIndexAsync(wordTargetIndex, refreshVisibleWordOffset: false);
                    break;
                case PageIntent.Last:
                    await SetPageIndexAsync(_pageCount - 1);
                    break;
                default:
                    await SetPageIndexAsync(0);
                    break;
            }
        }
        catch (JSException)
        {
        }
        finally
        {
            _pendingPageFraction = null;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SetPageIndexAsync(int pageIndex, bool refreshVisibleWordOffset = true)
    {
        _pageIndex = Math.Min(_pageCount - 1, Math.Max(0, pageIndex));

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("goToPage", _contentRef, _pageIndex);
            if (refreshVisibleWordOffset)
            {
                await RefreshVisibleWordOffsetAsync();
            }
        }
    }

    private async Task RefreshVisibleWordOffsetAsync()
    {
        if (_module is null || _chapter is null)
        {
            return;
        }

        try
        {
            var offset = await _module.InvokeAsync<int>("getVisibleWordOffset", _contentRef, _chapter.WordCount);
            _currentWordOffset = Math.Clamp(offset, 0, _chapter.WordCount);
        }
        catch (JSException)
        {
            _currentWordOffset = Math.Clamp(_currentWordOffset, 0, _chapter.WordCount);
        }
    }

    private async Task GoToNextPageAsync()
    {
        if (_chapter is null || _isLoadingChapter)
        {
            return;
        }

        if (_pageIndex >= _pageCount - 1)
        {
            if (_chapter.NextChapterId is { } nextId)
            {
                await LoadChapterAsync(nextId);
            }

            return;
        }

        await SetPageIndexAsync(_pageIndex + 1);
        await InvokeAsync(StateHasChanged);
    }

    private async Task GoToPreviousPageAsync()
    {
        if (_chapter is null || _isLoadingChapter)
        {
            return;
        }

        if (_pageIndex <= 0)
        {
            if (_chapter.PreviousChapterId is { } previousId)
            {
                await LoadChapterAsync(previousId, intent: PageIntent.Last);
            }

            return;
        }

        await SetPageIndexAsync(_pageIndex - 1);
        await InvokeAsync(StateHasChanged);
    }

    private Task HandleContentKeyDownAsync(KeyboardEventArgs args) => args.Key switch
    {
        "ArrowRight" or "PageDown" or " " => GoToNextPageAsync(),
        "ArrowLeft" or "PageUp" => GoToPreviousPageAsync(),
        _ => Task.CompletedTask
    };

    private async Task HandleSelectionChangedAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            _selectedText = await _module.InvokeAsync<string>("getSelectionText", _contentRef);
        }
        catch (JSException)
        {
            _selectedText = string.Empty;
        }
    }

    private async Task SaveNoteAsync()
    {
        if (_chapter is null || string.IsNullOrWhiteSpace(_selectedText) || _isSavingNote)
        {
            return;
        }

        _isSavingNote = true;
        _statusMessage = null;
        try
        {
            var url = $"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/book/notes";
            using var response = await Http.PostAsJsonAsync(
                url, new BookNoteRequest(_chapter.ChapterId, _selectedText, null, null));
            if (response.IsSuccessStatusCode)
            {
                ShowStatus("Note saved.");
                _selectedText = string.Empty;
                if (_module is not null)
                {
                    try
                    {
                        await _module.InvokeVoidAsync("clearSelection");
                    }
                    catch (JSException)
                    {
                    }
                }
            }
            else
            {
                ShowStatus("The note could not be saved.");
            }
        }
        catch (HttpRequestException)
        {
            ShowStatus("The note could not be saved.");
        }
        finally
        {
            _isSavingNote = false;
        }
    }

    private async Task CopySelectionAsync()
    {
        if (_module is null || string.IsNullOrWhiteSpace(_selectedText))
        {
            return;
        }

        try
        {
            var copied = await _module.InvokeAsync<bool>("copyText", _selectedText);
            ShowStatus(copied ? "Copied to clipboard." : "Copy is unavailable in this browser.");
        }
        catch (JSException)
        {
            ShowStatus("Copy is unavailable in this browser.");
        }
    }

    private void ShowStatus(string message)
    {
        _statusMessage = message;
        _statusCts?.Cancel();
        _statusCts?.Dispose();
        _statusCts = new CancellationTokenSource();
        _ = ClearStatusAfterDelayAsync(_statusCts.Token);
    }

    private async Task ClearStatusAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(4), cancellationToken);
            await InvokeAsync(() =>
            {
                _statusMessage = null;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SaveProgressAsync()
    {
        if (_chapter is null)
        {
            return;
        }

        try
        {
            await RefreshVisibleWordOffsetAsync();

            var url = $"api/archive/{Uri.EscapeDataString(Category)}/items/{Uri.EscapeDataString(ItemId)}/book/progress";
            using var response = await Http.PutAsJsonAsync(url, new BookProgressDto(_chapter.ChapterId, _currentWordOffset));
        }
        catch (HttpRequestException)
        {
            // Progress is best-effort; reading continues even if it cannot be saved.
        }
    }

    private async Task CloseAsync()
    {
        await SaveProgressAsync();
        await OnClose.InvokeAsync();
    }

    private static string FormatPercent(double value) =>
        value.ToString("P0", CultureInfo.CurrentCulture);

    private RenderFragment RenderNavItems(IReadOnlyList<BookNavigationItemDto> items) =>
        @<ul class="list-unstyled ps-3 mb-0">
            @foreach (var navItem in items)
            {
                <li class="mb-1">
                    @if (navItem.ChapterId is not null)
                    {
                        <button type="button"
                                class="btn btn-sm text-start text-decoration-none w-100 epub-reader-toc-button @(IsCurrentChapter(navItem.ChapterId) ? "active" : "")"
                                aria-current="@(IsCurrentChapter(navItem.ChapterId) ? "true" : null)"
                                @onclick="() => JumpToChapterAsync(navItem.ChapterId)">
                            @navItem.Title
                        </button>
                    }
                    else
                    {
                        <span class="d-block small fw-semibold text-body-secondary px-1 pt-1">@navItem.Title</span>
                    }
                    @if (navItem.Children.Count > 0)
                    {
                        @RenderNavItems(navItem.Children)
                    }
                </li>
            }
        </ul>;

    public async ValueTask DisposeAsync()
    {
        _statusCts?.Cancel();
        _statusCts?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
