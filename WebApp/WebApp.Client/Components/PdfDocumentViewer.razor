@implements IAsyncDisposable
@inject IJSRuntime JS

<section @ref="_containerElement" class="card overflow-hidden pdf-document-viewer d-flex flex-column h-100" aria-label="Document viewer">
    <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap">
        <div class="d-flex align-items-center gap-2 min-w-0">
            <button class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center justify-content-center"
                    style="width:40px;height:40px;"
                    type="button"
                    aria-label="Back to listing"
                    @onclick="BackAsync">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
            </button>
            <span class="fw-semibold text-truncate" title="@Name">@Name</span>
            <span class="badge text-bg-secondary text-uppercase">PDF</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1"
                    type="button"
                    aria-label="@(_isFullscreen ? "Exit fullscreen" : "View fullscreen")"
                    @onclick="ToggleFullscreenAsync">
                <i class="bi @(_isFullscreen ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    <div class="card-body p-0 d-flex flex-fill pdf-document-body">
        <iframe src="@PdfUrl" class="pdf-document-frame" title="@Name"></iframe>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string PdfUrl { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _containerElement;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PdfDocumentViewer>? _dotNetReference;
    private bool _isFullscreen;
    private bool _listenerRegistered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pdfDocumentViewer.js");
            }
            catch (JSException)
            {
            }
        }

        if (_module is null || _listenerRegistered)
        {
            return;
        }

        try
        {
            _listenerRegistered = true;
            _dotNetReference ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerFullscreenChange", _containerElement, _dotNetReference);
        }
        catch (JSException)
        {
            _listenerRegistered = false;
        }
    }

    private async Task ToggleFullscreenAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            _isFullscreen = await _module.InvokeAsync<bool>("toggleFullscreen", _containerElement);
        }
        catch (JSException)
        {
        }
    }

    [JSInvokable]
    public void OnFullscreenChanged(bool isFullscreen)
    {
        _isFullscreen = isFullscreen;
        StateHasChanged();
    }

    private async Task BackAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregisterFullscreenChange", _containerElement);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }

        _dotNetReference?.Dispose();
    }
}
