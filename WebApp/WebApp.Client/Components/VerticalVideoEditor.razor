@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="@EditorCssClass" aria-labelledby="editor-heading">
    <div class="editor-header">
        <div>
            <p class="section-label">Vertical preview</p>
            <h2 id="editor-heading">@(Selected?.Name ?? "Choose a video")</h2>
        </div>
        <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@(Selected is null)" @onclick="Reset">Reset crop</button>
    </div>

    @if (Selected is null)
    {
        <div class="editor-empty" role="status">
            <div class="empty-frame" aria-hidden="true"></div>
            <strong>No video selected</strong>
            <span>Scan the library and choose a clip to begin.</span>
        </div>
    }
    else
    {
        <div class="preview-stage">
            <div class="video-viewport" @ref="_viewport">
                <video @key="Selected.Id"
                       @ref="_video"
                       src="@($"api/videos/{Selected.Id}/stream")"
                       controls
                       muted
                       preload="metadata"
                       aria-label="Vertical preview of @Selected.Name"
                       style="object-position: @ObjectPosition"
                       @onpointerdown="StartDragAsync"
                       @onpointermove="MoveDrag"
                       @onpointerup="EndDragAsync"
                       @onpointercancel="EndDragAsync"
                       @onpointerleave="EndDragAsync"
                       @onlostpointercapture="EndDragAsync"
                       @onerror="ShowPlaybackError"
                       @onloadedmetadata="HandleLoadedMetadataAsync">
                    Your browser does not support HTML5 video.
                </video>
            </div>
            @if (_playbackError)
            {
                <div class="playback-error" role="alert" aria-live="assertive">
                    This browser can’t play the video’s encoding. You can still select another clip or reset the crop.
                </div>
            }
            <div class="editor-helper">
                <div class="crop-helper-copy">
                    <p class="position-readout" aria-live="off">Crop position: @Math.Round(_frame.PositionX)% horizontal · @Math.Round(_frame.PositionY)% vertical</p>
                    <p class="drag-hint">Drag the video with a mouse, touch, or pen to reposition cropped content.</p>
                </div>
                <div class="fill-tab-control">
                    <button @ref="_fillTabButton"
                            class="fill-tab-button"
                            type="button"
                            aria-label="Fill browser tab"
                            aria-describedby="fill-tab-tooltip"
                            @onclick="EnterFillTabAsync">
                        <svg class="bi bi-arrows-fullscreen" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" />
                        </svg>
                    </button>
                    <span id="fill-tab-tooltip" class="fill-tab-tooltip" role="tooltip">Fill this browser tab. Press Escape to exit.</span>
                </div>
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public VideoItemDto? Selected { get; set; }

    private readonly VideoFrameState _frame = new();
    private readonly FillTabState _fillTab = new();
    private ElementReference _viewport;
    private ElementReference _video;
    private ElementReference _fillTabButton;
    private IJSObjectReference? _module;
    private DotNetObjectReference<VerticalVideoEditor>? _dotNetReference;
    private DragSession? _drag;
    private bool _playbackError;
    private bool _pendingInitialMute;
    private bool _pendingFillTabCleanup;
    private bool _pendingFillTabFocus;

    private string EditorCssClass => _fillTab.IsActive
        ? "editor-card fill-tab-mode"
        : "editor-card";

    private string ObjectPosition => FormattableString.Invariant(
        $"{_frame.PositionX:0.##}% {_frame.PositionY:0.##}%");

    protected override void OnParametersSet()
    {
        if (!string.Equals(_frame.SelectionId, Selected?.Id, StringComparison.Ordinal))
        {
            _frame.Select(Selected?.Id);
            _pendingFillTabCleanup |= _fillTab.Select(Selected?.Id);
            _drag = null;
            _playbackError = false;
            _pendingInitialMute = Selected is not null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/videoEditor.js");
        }

        if (_module is not null && _pendingFillTabCleanup)
        {
            await _module.InvokeVoidAsync("exitFillTab");
            _pendingFillTabCleanup = false;
        }

        if (_module is not null && Selected is not null && _pendingInitialMute)
        {
            await _module.InvokeVoidAsync("setMuted", _video);
            _pendingInitialMute = false;
        }

        if (_pendingFillTabFocus && !_fillTab.IsActive)
        {
            _pendingFillTabFocus = false;
            await _fillTabButton.FocusAsync();
        }
    }

    private async Task EnterFillTabAsync()
    {
        if (_module is null || !_fillTab.Enter())
        {
            return;
        }

        _dotNetReference ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("enterFillTab", _dotNetReference);
    }

    [JSInvokable]
    public async Task ExitFillTabFromEscapeAsync()
    {
        var exited = _fillTab.Exit();
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("exitFillTab");
        }

        if (exited)
        {
            _pendingFillTabFocus = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartDragAsync(PointerEventArgs args)
    {
        if (_module is null || Selected is null || !args.IsPrimary)
        {
            return;
        }

        var geometry = await _module.InvokeAsync<VideoGeometry>(
            "measureAndCapture", _viewport, _video, args.PointerId);
        _drag = new DragSession(args.PointerId, args.ClientX, args.ClientY,
            _frame.PositionX, _frame.PositionY, geometry);
    }

    private void MoveDrag(PointerEventArgs args)
    {
        if (_drag is null || _drag.PointerId != args.PointerId)
        {
            return;
        }

        _frame.ApplyDrag(_drag.StartPositionX, _drag.StartPositionY,
            args.ClientX - _drag.StartClientX, args.ClientY - _drag.StartClientY,
            _drag.Geometry.ViewportWidth, _drag.Geometry.ViewportHeight,
            _drag.Geometry.VideoWidth, _drag.Geometry.VideoHeight);
    }

    private async Task EndDragAsync(PointerEventArgs args)
    {
        if (_drag is null || _drag.PointerId != args.PointerId)
        {
            return;
        }

        _drag = null;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("releasePointer", _video, args.PointerId);
        }
    }

    private void Reset() => _frame.Reset();
    private void ShowPlaybackError() => _playbackError = true;

    private async Task HandleLoadedMetadataAsync()
    {
        _playbackError = false;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setMuted", _video);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _fillTab.Exit();

        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("exitFillTab");
            }
        }
        finally
        {
            _dotNetReference?.Dispose();
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
    }

    private sealed record VideoGeometry(double ViewportWidth, double ViewportHeight, double VideoWidth, double VideoHeight);
    private sealed record DragSession(long PointerId, double StartClientX, double StartClientY,
        double StartPositionX, double StartPositionY, VideoGeometry Geometry);
}
