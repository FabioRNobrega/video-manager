@using System.Globalization
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<section class="@EditorCssClass" aria-labelledby="editor-heading">
    <div class="@EditorHeaderCssClass">
        <div>
            <p class="small fw-bold text-uppercase text-body-secondary mb-0">Vertical preview</p>
            <h2 id="editor-heading" class="h5 text-break mb-0">@(Selected?.Name ?? "Choose a video")</h2>
        </div>
        <button class="btn btn-secondary btn-sm d-inline-flex align-items-center gap-2 flex-shrink-0"
                type="button"
                disabled="@(Selected is null)"
                @onclick="Reset">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
            Reset crop
        </button>
    </div>

    @if (Selected is null)
    {
        <div class="card-body d-flex flex-column align-items-center justify-content-center gap-2 py-5 my-5 text-center text-body-secondary"
             role="status">
            <i class="bi bi-aspect-ratio display-1 lh-1 text-primary mb-2" aria-hidden="true"></i>
            <strong class="fs-5 text-body">No video selected</strong>
            <span>Scan the library and choose a clip to begin.</span>
        </div>
    }
    else
    {
        <div class="@PreviewStageCssClass">
            <div class="@VideoViewportCssClass" style="@VideoViewportStyle" @ref="_viewport">
                <video @key="Selected.Id"
                       @ref="_video"
                       class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover user-select-none"
                       src="@($"{StreamBasePath}/{Selected.Id}/stream")"
                       muted
                       preload="metadata"
                       aria-label="Vertical preview of @Selected.Name"
                       style="@VideoStyle"
                       @onpointerdown="StartDragAsync"
                       @onpointermove="MoveDrag"
                       @onpointerup="args => EndDragAsync(args, revealControls: true)"
                       @onpointercancel="args => EndDragAsync(args, revealControls: false)"
                       @onpointerleave="args => EndDragAsync(args, revealControls: false)"
                       @onlostpointercapture="args => EndDragAsync(args, revealControls: false)"
                       @onerror="ShowPlaybackError"
                       @onloadedmetadata="HandleLoadedMetadataAsync"
                       @ondurationchange="SynchronizeMediaStateAsync"
                       @onplay="SynchronizeMediaStateAsync"
                       @onpause="SynchronizeMediaStateAsync"
                       @ontimeupdate="HandleTimeUpdateAsync"
                       @onvolumechange="SynchronizeMediaStateAsync"
                       @onratechange="SynchronizeMediaStateAsync"
                       @onseeking="SynchronizeMediaStateAsync"
                       @onseeked="HandleSeekedAsync"
                       @onended="SynchronizeMediaStateAsync">
                    Your browser does not support HTML5 video.
                </video>
                <div class="@SaturationRailCssClass"
                     aria-hidden="@(!_controlsVisible)"
                     @onmouseenter="HandleControlHoverStarted"
                     @onmouseleave="HandleControlHoverEnded">
                    <div class="btn-group" role="group" aria-label="Saturation actions">
                        <button class="btn btn-player btn-outline-light d-inline-flex align-items-center justify-content-center p-1 saturation-reset"
                                type="button"
                                disabled="@(_saturation.Value == SaturationState.Default)"
                                aria-label="Reset saturation"
                                title="Reset saturation"
                                @onclick="ResetSaturation">
                            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                        </button>
                    </div>
                    <input class="form-range saturation-range"
                           type="range"
                           min="0"
                           max="@Invariant(SaturationState.Max)"
                           step="1"
                           value="@Invariant(_saturation.Value)"
                           aria-label="Saturation"
                           @oninput="HandleSaturationInput" />
                    <output class="small text-white saturation-output" aria-hidden="true">@Math.Round(_saturation.Value)%</output>
                </div>
                <MediaPlayerControls State="_player"
                                     IsVisible="_controlsVisible"
                                     Error="@_playerError"
                                     TogglePlayback="TogglePlaybackAsync"
                                     Seek="SeekAsync"
                                     ToggleMute="ToggleMuteAsync"
                                     SetVolume="SetVolumeAsync"
                                     SetPlaybackRate="SetPlaybackRateAsync"
                                     ToggleStandardLoop="ToggleStandardLoopAsync"
                                     SkipBackward="SkipBackwardAsync"
                                     SkipForward="SkipForwardAsync"
                                     SetMarkerA="SetMarkerA"
                                     SetMarkerB="SetMarkerB"
                                     ToggleAbLoop="ToggleAbLoopAsync"
                                     SaveCut="SaveCutAsync"
                                     IsSavingCut="_isSavingCut"
                                     ClearAbLoop="ClearAbLoop"
                                     InteractionStarted="HandleControlInteractionStarted"
                                     InteractionEnded="HandleControlInteractionEnded"
                                     HoverStarted="HandleControlHoverStarted"
                                     HoverEnded="HandleControlHoverEnded"
                                     EnterFillTab="EnterFillTabAsync"
                                     IsFillTabActive="_fillTab.IsActive"
                                     FillTabFocusRequest="_fillTabFocusRequest" />
            </div>
            @if (_playbackError && !_fillTab.IsActive)
            {
                <div class="alert alert-danger w-100 mt-3 mb-0 text-center" role="alert" aria-live="assertive">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    This browser can’t play the video’s encoding. You can still select another clip or reset the crop.
                </div>
            }
            @if (!_fillTab.IsActive)
            {
                <div class="small text-body-secondary text-center mt-3">
                    <p class="mb-1" aria-live="off">Crop position: @Math.Round(_frame.PositionX)% horizontal · @Math.Round(_frame.PositionY)% vertical</p>
                    <p class="mb-0">Drag the video with a mouse, touch, or pen to reposition cropped content.</p>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter] public VideoItemDto? Selected { get; set; }
    [Parameter] public string StreamBasePath { get; set; } = "api/videos";
    [Parameter] public EventCallback CutQueued { get; set; }
    [Parameter] public int CutCompletionSignal { get; set; }

    private const double DragThreshold = 6;
    private static readonly TimeSpan ControlHideDelay = TimeSpan.FromSeconds(1);

    private readonly VideoFrameState _frame = new();
    private readonly FillTabState _fillTab = new();
    private readonly MediaPlayerState _player = new();
    private readonly SaturationState _saturation = new();
    private ElementReference _viewport;
    private ElementReference _video;
    private IJSObjectReference? _module;
    private DotNetObjectReference<VerticalVideoEditor>? _dotNetReference;
    private CancellationTokenSource? _controlsHideCancellation;
    private DragSession? _drag;
    private bool _playbackError;
    private string? _playerError;
    private bool _pendingMediaInitialization;
    private bool _pendingFillTabCleanup;
    private int _fillTabFocusRequest;
    private bool _pendingControlsTimer;
    private bool _controlsVisible;
    private bool _controlInteractionActive;
    private bool _controlHoverActive;
    private bool _abSeekPending;
    private bool _isSavingCut;
    private int _observedCutCompletionSignal;
    private bool _disposed;

    private string EditorCssClass => _fillTab.IsActive
        ? "card position-fixed top-0 start-0 z-3 w-100 h-100 overflow-hidden border-0 rounded-0"
        : "card overflow-hidden";

    private string EditorHeaderCssClass => _fillTab.IsActive
        ? "d-none"
        : "card-header d-flex align-items-center justify-content-between gap-3";

    private string PreviewStageCssClass => _fillTab.IsActive
        ? "w-100 h-100 p-0 bg-dark"
        : "d-flex flex-column align-items-center bg-body-tertiary p-3 p-md-4";

    private string VideoViewportCssClass => _fillTab.IsActive
        ? "position-relative w-100 h-100 overflow-hidden bg-dark"
        : "ratio position-relative w-100 overflow-hidden bg-dark border rounded-3 shadow-lg";

    private string? VideoViewportStyle => _fillTab.IsActive
        ? null
        : "--bs-aspect-ratio: 177.777%; max-width: 24rem";

    private string VideoStyle => FormattableString.Invariant(
        $"object-position: {_frame.PositionX:0.##}% {_frame.PositionY:0.##}%; touch-action: none; filter: saturate({_saturation.Value:0}%)");

    private string SaturationRailCssClass =>
        $"saturation-rail position-absolute z-3 d-flex flex-column align-items-center gap-2 text-white user-select-none {(_controlsVisible ? "is-visible visible opacity-100 pe-auto" : "invisible opacity-0 pe-none")}";

    protected override void OnParametersSet()
    {
        if (CutCompletionSignal != _observedCutCompletionSignal)
        {
            _observedCutCompletionSignal = CutCompletionSignal;
            _isSavingCut = false;
        }

        if (!string.Equals(_frame.SelectionId, Selected?.Id, StringComparison.Ordinal))
        {
            HandleSelectionChanged();
        }
    }

    private void HandleSelectionChanged()
    {
        _frame.Select(Selected?.Id);
        _player.Select(Selected?.Id);
        _saturation.Select(Selected?.Id);
        _pendingFillTabCleanup |= _fillTab.Select(Selected?.Id);
        _drag = null;
        _playbackError = false;
        _playerError = null;
        _isSavingCut = false;
        _abSeekPending = false;
        _pendingMediaInitialization = Selected is not null;
        _controlsVisible = Selected is not null;
        _pendingControlsTimer = Selected is not null;
        _controlInteractionActive = false;
        _controlHoverActive = false;
        CancelControlsHideTimer();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/videoEditor.js");
        }

        if (_module is not null && _pendingFillTabCleanup)
        {
            await _module.InvokeVoidAsync("exitFillTab");
            _pendingFillTabCleanup = false;
        }

        if (_module is not null && Selected is not null && _pendingMediaInitialization)
        {
            _pendingMediaInitialization = false;
            await ApplyPlayerPreferencesAsync();
        }

        if (_pendingControlsTimer && Selected is not null)
        {
            _pendingControlsTimer = false;
            ArmControlsHideTimer();
        }

    }

    private async Task EnterFillTabAsync()
    {
        if (_module is null)
        {
            return;
        }

        if (_fillTab.IsActive)
        {
            await ExitFillTabAsync();
            return;
        }

        if (!_fillTab.Enter())
        {
            return;
        }

        _dotNetReference ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("enterFillTab", _dotNetReference);
    }

    [JSInvokable]
    public Task ExitFillTabFromEscapeAsync() => ExitFillTabAsync();

    private async Task ExitFillTabAsync()
    {
        var exited = _fillTab.Exit();
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("exitFillTab");
        }

        if (exited)
        {
            _fillTabFocusRequest++;
            RevealControls();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartDragAsync(PointerEventArgs args)
    {
        if (_module is null || Selected is null || !args.IsPrimary)
        {
            return;
        }

        var geometry = await _module.InvokeAsync<VideoGeometry>(
            "measureAndCapture", _viewport, _video, args.PointerId);
        _drag = new DragSession(args.PointerId, args.ClientX, args.ClientY,
            _frame.PositionX, _frame.PositionY, geometry);
    }

    private void MoveDrag(PointerEventArgs args)
    {
        if (_drag is null || _drag.PointerId != args.PointerId)
        {
            return;
        }

        var deltaX = args.ClientX - _drag.StartClientX;
        var deltaY = args.ClientY - _drag.StartClientY;
        _drag.HasMoved |= Math.Sqrt((deltaX * deltaX) + (deltaY * deltaY)) >= DragThreshold;
        if (!_drag.HasMoved)
        {
            return;
        }

        _frame.ApplyDrag(_drag.StartPositionX, _drag.StartPositionY,
            deltaX, deltaY,
            _drag.Geometry.ViewportWidth, _drag.Geometry.ViewportHeight,
            _drag.Geometry.VideoWidth, _drag.Geometry.VideoHeight);
    }

    private async Task EndDragAsync(PointerEventArgs args, bool revealControls)
    {
        if (_drag is null || _drag.PointerId != args.PointerId)
        {
            return;
        }

        var completedDrag = _drag;
        _drag = null;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("releasePointer", _video, args.PointerId);
        }

        if (revealControls && !completedDrag.HasMoved)
        {
            RevealControls();
        }
    }

    private void Reset() => _frame.Reset();
    private void ShowPlaybackError() => _playbackError = true;

    private void HandleSaturationInput(ChangeEventArgs args)
    {
        if (double.TryParse(Convert.ToString(args.Value, CultureInfo.InvariantCulture), NumberStyles.Float,
                CultureInfo.InvariantCulture, out var value))
        {
            _saturation.SetValue(value);
        }
    }

    private void ResetSaturation() => _saturation.Reset();

    private static string Invariant(double value) => value.ToString("0", CultureInfo.InvariantCulture);

    private async Task HandleLoadedMetadataAsync()
    {
        _playbackError = false;
        await ApplyPlayerPreferencesAsync();
    }

    private async Task ApplyPlayerPreferencesAsync()
    {
        if (_module is null || Selected is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("setVolume", _video, _player.Volume);
            await _module.InvokeVoidAsync("setMuted", _video, _player.IsMuted);
            await _module.InvokeVoidAsync("setPlaybackRate", _video, _player.PlaybackRate);
            await _module.InvokeVoidAsync("setLoop", _video, false);
            await SynchronizeMediaStateAsync();
        }
        catch (JSException)
        {
            ShowPlayerCommandError();
        }
    }

    private async Task SynchronizeMediaStateAsync()
    {
        if (_module is null || Selected is null)
        {
            return;
        }

        var snapshot = await _module.InvokeAsync<MediaSnapshot>("readMediaSnapshot", _video);
        _player.Synchronize(snapshot);
    }

    private async Task HandleTimeUpdateAsync()
    {
        await SynchronizeMediaStateAsync();
        if (_module is null || _abSeekPending || !_player.TryMoveToAbStart(out var target))
        {
            return;
        }

        _abSeekPending = true;
        await ExecuteMediaCommandAsync("seekVideo", target);
    }

    private async Task HandleSeekedAsync()
    {
        _abSeekPending = false;
        await SynchronizeMediaStateAsync();
    }

    private Task TogglePlaybackAsync() => ExecuteMediaCommandAsync(
        _player.IsPlaying ? "pauseVideo" : "playVideo");

    private async Task SeekAsync(double value)
    {
        _player.PreviewTime(value);
        await ExecuteMediaCommandAsync("seekVideo", _player.CurrentTime);
    }

    private const double SkipSeconds = 10;

    private Task SkipBackwardAsync() => SeekAsync(_player.CurrentTime - SkipSeconds);

    private Task SkipForwardAsync() => SeekAsync(_player.CurrentTime + SkipSeconds);

    private Task ToggleMuteAsync() => ExecuteMediaCommandAsync("setMuted", !_player.IsMuted);

    private Task SetVolumeAsync(double value) =>
        ExecuteMediaCommandAsync("setVolume", Math.Clamp(value, 0, 1));

    private Task SetPlaybackRateAsync(double value) =>
        ExecuteMediaCommandAsync("setPlaybackRate", value);

    private async Task ToggleStandardLoopAsync()
    {
        _player.SetStandardLoop(!_player.IsStandardLoop);
        await ExecuteMediaCommandAsync("setLoop", _player.IsStandardLoop);
        await SynchronizeMediaStateAsync();
    }

    private void SetMarkerA() => _player.SetMarkerA();
    private void SetMarkerB() => _player.SetMarkerB();

    private async Task ToggleAbLoopAsync()
    {
        var enable = !_player.IsAbLoop;
        if (!_player.SetAbLoop(enable))
        {
            return;
        }

        if (enable)
        {
            await ExecuteMediaCommandAsync("setLoop", false);
            await SynchronizeMediaStateAsync();
        }
    }

    private async Task SaveCutAsync()
    {
        if (Selected is null || !_player.HasValidAbRange || _player.MarkerA is null || _player.MarkerB is null || _isSavingCut)
        {
            return;
        }

        try
        {
            _isSavingCut = true;
            _playerError = null;
            using var response = await Http.PostAsJsonAsync(
                $"api/videos/{Selected.Id}/cuts",
                new CutRequest(_player.MarkerA.Value, _player.MarkerB.Value));

            if (!response.IsSuccessStatusCode)
            {
                _isSavingCut = false;
                _playerError = "The cut could not be queued. Check the A/B points and try again.";
                RevealControls();
                return;
            }

            await CutQueued.InvokeAsync();
        }
        catch (HttpRequestException)
        {
            _isSavingCut = false;
            _playerError = "The cut service could not be reached. Try again.";
            RevealControls();
        }
        catch (TaskCanceledException)
        {
            _isSavingCut = false;
            _playerError = "The cut request was interrupted. Try again.";
            RevealControls();
        }
    }

    private void ClearAbLoop() => _player.ClearAbLoop();

    private async Task ExecuteMediaCommandAsync(string identifier, params object?[] values)
    {
        if (_module is null || Selected is null)
        {
            return;
        }

        var arguments = new object?[values.Length + 1];
        arguments[0] = _video;
        Array.Copy(values, 0, arguments, 1, values.Length);

        try
        {
            _playerError = null;
            await _module.InvokeVoidAsync(identifier, arguments);
        }
        catch (JSException)
        {
            ShowPlayerCommandError();
        }
    }

    private void ShowPlayerCommandError()
    {
        _playerError = "The browser couldn’t complete that media command. Try again or choose another clip.";
        RevealControls();
    }

    private void HandleControlInteractionStarted()
    {
        _controlInteractionActive = true;
        _controlsVisible = true;
        CancelControlsHideTimer();
    }

    private void HandleControlInteractionEnded()
    {
        _controlInteractionActive = false;
        ArmControlsHideTimer();
    }

    private void HandleControlHoverStarted()
    {
        _controlHoverActive = true;
        _controlsVisible = true;
        CancelControlsHideTimer();
    }

    private void HandleControlHoverEnded()
    {
        _controlHoverActive = false;
        ArmControlsHideTimer();
    }

    private void RevealControls()
    {
        _controlsVisible = true;
        ArmControlsHideTimer();
    }

    private void ArmControlsHideTimer()
    {
        CancelControlsHideTimer();
        if (_disposed || Selected is null || _controlInteractionActive || _controlHoverActive)
        {
            return;
        }

        _controlsHideCancellation = new CancellationTokenSource();
        _ = HideControlsAfterDelayAsync(_controlsHideCancellation.Token);
    }

    private async Task HideControlsAfterDelayAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(ControlHideDelay, cancellationToken);
            await InvokeAsync(() =>
            {
                if (!_controlInteractionActive && !_controlHoverActive)
                {
                    _controlsVisible = false;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelControlsHideTimer()
    {
        _controlsHideCancellation?.Cancel();
        _controlsHideCancellation?.Dispose();
        _controlsHideCancellation = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        CancelControlsHideTimer();
        _fillTab.Exit();

        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("exitFillTab");
            }
        }
        finally
        {
            _dotNetReference?.Dispose();
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
    }

    private sealed record VideoGeometry(double ViewportWidth, double ViewportHeight, double VideoWidth, double VideoHeight);

    private sealed record CutRequest(double Start, double End);

    private sealed class DragSession(long pointerId, double startClientX, double startClientY,
        double startPositionX, double startPositionY, VideoGeometry geometry)
    {
        public long PointerId { get; } = pointerId;
        public double StartClientX { get; } = startClientX;
        public double StartClientY { get; } = startClientY;
        public double StartPositionX { get; } = startPositionX;
        public double StartPositionY { get; } = startPositionY;
        public VideoGeometry Geometry { get; } = geometry;
        public bool HasMoved { get; set; }
    }
}
