@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject IJSRuntime JS

<div class="form-check form-switch d-flex align-items-center gap-2 mb-0" data-theme-mode="@_theme">
    <input class="form-check-input mt-0"
           id="theme-mode-switch"
           type="checkbox"
           role="switch"
           checked="@(_theme == DarkTheme)"
           aria-label="@ActionLabel"
           @onchange="ToggleAsync" />
    <label class="form-check-label d-flex align-items-center text-body-secondary"
           for="theme-mode-switch"
           title="@ActionLabel">
        <i class="bi @ThemeIconClass text-primary" aria-hidden="true"></i>
    </label>
</div>

@code {
    private const string DarkTheme = "dark";
    private const string LightTheme = "light";

    private string _theme = DarkTheme;
    private string ActionLabel => _theme == DarkTheme ? "Switch to light mode" : "Switch to dark mode";
    private string ThemeIconClass => _theme == DarkTheme ? "bi-moon-stars-fill" : "bi-sun-fill";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _theme = NormalizeTheme(await JS.InvokeAsync<string>("videoManagerTheme.getTheme"));
            StateHasChanged();
        }
        catch (JSException)
        {
            _theme = DarkTheme;
        }
    }

    private async Task ToggleAsync()
    {
        try
        {
            _theme = NormalizeTheme(await JS.InvokeAsync<string>("videoManagerTheme.toggleTheme"));
        }
        catch (JSException)
        {
            // The root markup already provides the safe dark fallback.
        }
    }

    private static string NormalizeTheme(string? theme) => theme == LightTheme ? LightTheme : DarkTheme;
}
