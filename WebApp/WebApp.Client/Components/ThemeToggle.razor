@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject IJSRuntime JS

<button class="theme-toggle"
        type="button"
        aria-label="@ActionLabel"
        title="@ActionLabel"
        data-theme-mode="@_theme"
        @onclick="ToggleAsync">
    @if (_theme == LightTheme)
    {
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.4 15.2A8.5 8.5 0 0 1 8.8 3.6 8.5 8.5 0 1 0 20.4 15.2Z" />
        </svg>
    }
    else
    {
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
    }
</button>

@code {
    private const string DarkTheme = "dark";
    private const string LightTheme = "light";

    private string _theme = DarkTheme;
    private string ActionLabel => _theme == DarkTheme ? "Switch to light mode" : "Switch to dark mode";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _theme = NormalizeTheme(await JS.InvokeAsync<string>("videoManagerTheme.getTheme"));
            StateHasChanged();
        }
        catch (JSException)
        {
            _theme = DarkTheme;
        }
    }

    private async Task ToggleAsync()
    {
        try
        {
            _theme = NormalizeTheme(await JS.InvokeAsync<string>("videoManagerTheme.toggleTheme"));
        }
        catch (JSException)
        {
            // The root markup already provides the safe dark fallback.
        }
    }

    private static string NormalizeTheme(string? theme) => theme == LightTheme ? LightTheme : DarkTheme;
}
