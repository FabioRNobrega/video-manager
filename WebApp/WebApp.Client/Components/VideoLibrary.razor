<section class="card mb-3 overflow-hidden" aria-labelledby="library-heading">
    <div class="card-header d-flex align-items-center justify-content-between gap-3">
        <div>
            <p class="small fw-bold text-uppercase text-body-secondary mb-0">Library</p>
            <h2 id="library-heading" class="h5 mb-0">Your videos</h2>
        </div>
        <button class="btn btn-primary d-inline-flex align-items-center justify-content-center"
                type="button"
                disabled="@IsScanning"
                @onclick="OnScan">
            @if (IsScanning)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-arrow-repeat me-2" aria-hidden="true"></i>
            }
            @(HasScanned ? "Rescan" : "Scan")
        </button>
    </div>

    @if (IsScanning)
    {
        <div class="card-body d-flex flex-column align-items-center gap-2 py-5 text-center text-body-secondary"
             role="status"
             aria-live="polite">
            <i class="bi bi-search fs-2 text-primary" aria-hidden="true"></i>
            <strong class="fs-5 text-body">Scanning your library…</strong>
            <span>Looking for supported video files.</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger d-flex flex-column align-items-center gap-2 m-3 text-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-2" aria-hidden="true"></i>
            <strong class="fs-5">Scan failed</strong>
            <span>@Error</span>
        </div>
    }
    else if (!HasScanned)
    {
        <div class="card-body d-flex flex-column align-items-center gap-2 py-5 text-center text-body-secondary"
             role="status">
            <i class="bi bi-collection-play fs-2 text-primary" aria-hidden="true"></i>
            <strong class="fs-5 text-body">Ready when you are</strong>
            <span>Nothing is read until you choose Scan.</span>
        </div>
    }
    else if (Items.Count == 0)
    {
        <div class="card-body d-flex flex-column align-items-center gap-2 py-5 text-center text-body-secondary"
             role="status"
             aria-live="polite">
            <i class="bi bi-film fs-2 text-primary" aria-hidden="true"></i>
            <strong class="fs-5 text-body">No supported videos found</strong>
            <span>Add MP4, WebM, MOV, or M4V files, then rescan.</span>
        </div>
    }
    else
    {
        <p class="small text-body-secondary border-bottom mb-0 px-3 py-2" role="status">
            @Items.Count @(Items.Count == 1 ? "video" : "videos")
        </p>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-3 p-3"
             aria-label="Discovered videos">
            @foreach (var item in Items)
            {
                var selected = item.Id == SelectedId;
                <div class="col">
                    <button class="card position-relative w-100 h-100 overflow-hidden p-0 text-start text-body @(selected ? "border-primary border-2" : null)"
                            type="button"
                            aria-pressed="@selected"
                            @onclick="() => OnSelect.InvokeAsync(item)"
                            @onmouseenter="() => OnCardMouseEnter(item)"
                            @onmouseleave="OnCardMouseLeave">
                        @if (selected)
                        {
                            <span class="badge text-bg-primary position-absolute top-0 end-0 z-1 m-2">
                                <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>Selected
                            </span>
                        }
                        <span class="ratio ratio-16x9 bg-body-tertiary border-bottom" aria-hidden="true">
                            @if (item.Id == _previewingVideoId && item.HoverPreviewState == HoverPreviewState.Ready && !string.IsNullOrEmpty(item.HoverPreviewUrl))
                            {
                                <video src="@item.HoverPreviewUrl"
                                       poster="@item.ThumbnailUrl"
                                       class="w-100 h-100 object-fit-cover"
                                       autoplay
                                       muted
                                       loop
                                       playsinline>
                                </video>
                            }
                            else if (item.ThumbnailState == ThumbnailState.Ready && !string.IsNullOrEmpty(item.ThumbnailUrl))
                            {
                                <img src="@item.ThumbnailUrl" alt="" class="w-100 h-100 object-fit-cover" />
                            }
                            else
                            {
                                <span class="d-flex align-items-center justify-content-center">
                                    <i class="bi bi-film display-1 lh-1 text-body-secondary"></i>
                                </span>
                            }
                        </span>
                        <span class="card-body d-flex flex-column w-100">
                            <span class="card-title d-block fw-semibold text-break mb-2">
                                @item.Name
                            </span>
                            <span class="card-text d-flex justify-content-between gap-2 small text-body-secondary mt-auto">
                                <span>@item.Extension.TrimStart('.').ToUpperInvariant()</span>
                                <span class="text-nowrap">@FormatSize(item.SizeBytes)</span>
                            </span>
                        </span>
                    </button>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<VideoItemDto> Items { get; set; } = Array.Empty<VideoItemDto>();
    [Parameter] public bool HasScanned { get; set; }
    [Parameter] public bool IsScanning { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public EventCallback OnScan { get; set; }
    [Parameter] public EventCallback<VideoItemDto> OnSelect { get; set; }

    private static readonly TimeSpan HoverDelay = TimeSpan.FromMilliseconds(300);

    private string? _previewingVideoId;
    private CancellationTokenSource? _hoverDelayCts;

    private void OnCardMouseEnter(VideoItemDto item)
    {
        _hoverDelayCts?.Cancel();
        _hoverDelayCts?.Dispose();
        var cts = new CancellationTokenSource();
        _hoverDelayCts = cts;

        _ = ActivatePreviewAfterDelayAsync(item, cts);
    }

    private void OnCardMouseLeave()
    {
        _hoverDelayCts?.Cancel();
        _hoverDelayCts?.Dispose();
        _hoverDelayCts = null;

        if (_previewingVideoId is not null)
        {
            _previewingVideoId = null;
            StateHasChanged();
        }
    }

    private async Task ActivatePreviewAfterDelayAsync(VideoItemDto item, CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(HoverDelay, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        if (item.HoverPreviewState != HoverPreviewState.Ready || string.IsNullOrEmpty(item.HoverPreviewUrl))
        {
            return;
        }

        _previewingVideoId = item.Id;
        StateHasChanged();
    }

    private static string FormatSize(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var size = (double)Math.Max(0, bytes);
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return unit == 0 ? $"{size:0} {units[unit]}" : $"{size:0.#} {units[unit]}";
    }
}
