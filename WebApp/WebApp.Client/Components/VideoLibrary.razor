<section class="card mb-3 overflow-hidden" aria-labelledby="library-heading">
    <div class="card-header d-flex align-items-center justify-content-between gap-3">
        <div>
            <p class="small fw-bold text-uppercase text-body-secondary mb-0">Library</p>
            <h2 id="library-heading" class="h5 mb-0">Your videos</h2>
        </div>
        <button class="btn btn-primary d-inline-flex align-items-center justify-content-center"
                type="button"
                disabled="@IsScanning"
                @onclick="OnScan">
            @if (IsScanning)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-arrow-repeat me-2" aria-hidden="true"></i>
            }
            @(HasScanned ? "Rescan" : "Scan")
        </button>
    </div>

    <VideoGrid Items="Items"
               HasLoaded="HasScanned"
               IsLoading="IsScanning"
               Error="@Error"
               SelectedId="@SelectedId"
               PreviewingVideoId="@_previewingVideoId"
               OnSelect="OnSelect"
               OnCardMouseEnter="OnCardMouseEnter"
               OnCardMouseLeave="OnCardMouseLeave"
               GridLabel="Discovered videos"
               LoadingTitle="Scanning your library..."
               LoadingMessage="Looking for supported video files."
               ErrorTitle="Scan failed"
               NotLoadedTitle="Ready when you are"
               NotLoadedMessage="Nothing is read until you choose Scan."
               EmptyTitle="No supported videos found"
               EmptyMessage="Add MP4, WebM, MOV, or M4V files, then rescan." />
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<VideoItemDto> Items { get; set; } = Array.Empty<VideoItemDto>();
    [Parameter] public bool HasScanned { get; set; }
    [Parameter] public bool IsScanning { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public EventCallback OnScan { get; set; }
    [Parameter] public EventCallback<VideoItemDto> OnSelect { get; set; }

    private static readonly TimeSpan HoverDelay = TimeSpan.FromMilliseconds(300);

    private string? _previewingVideoId;
    private CancellationTokenSource? _hoverDelayCts;

    private void OnCardMouseEnter(VideoItemDto item)
    {
        _hoverDelayCts?.Cancel();
        _hoverDelayCts?.Dispose();
        var cts = new CancellationTokenSource();
        _hoverDelayCts = cts;

        _ = ActivatePreviewAfterDelayAsync(item, cts);
    }

    private void OnCardMouseLeave()
    {
        _hoverDelayCts?.Cancel();
        _hoverDelayCts?.Dispose();
        _hoverDelayCts = null;

        if (_previewingVideoId is not null)
        {
            _previewingVideoId = null;
            StateHasChanged();
        }
    }

    private async Task ActivatePreviewAfterDelayAsync(VideoItemDto item, CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(HoverDelay, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        if (item.HoverPreviewState != HoverPreviewState.Ready || string.IsNullOrEmpty(item.HoverPreviewUrl))
        {
            return;
        }

        _previewingVideoId = item.Id;
        StateHasChanged();
    }
}
