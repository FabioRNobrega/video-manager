@inject HttpClient Http
@inject IJSRuntime JS
@inject PersistentPlayerState PlayerState
@inject NavigationManager Navigation
@implements IDisposable

<section class="card overflow-hidden" aria-labelledby="@HeadingId">
    <div class="card-header d-flex align-items-center justify-content-between gap-3 flex-wrap">
        <nav id="@HeadingId" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                @if (_listing is null || _listing.Breadcrumbs.Count == 0)
                {
                    <li class="breadcrumb-item active" aria-current="page">@Title</li>
                }
                else
                {
                    <li class="breadcrumb-item">
                        <button class="btn btn-link p-0 align-baseline" type="button" disabled="@_operationPending" @onclick="() => LoadAsync(null)">
                            @_listing.DisplayName
                        </button>
                    </li>
                    @foreach (var breadcrumb in _listing.Breadcrumbs)
                    {
                        var isCurrent = breadcrumb == _listing.Breadcrumbs[^1];
                        if (isCurrent)
                        {
                            <li class="breadcrumb-item active text-break" aria-current="page">@breadcrumb.Name</li>
                        }
                        else
                        {
                            <li class="breadcrumb-item">
                                <button class="btn btn-link p-0 align-baseline text-break"
                                        type="button"
                                        disabled="@_operationPending"
                                        @onclick="() => LoadAsync(breadcrumb.FolderId)">
                                    @breadcrumb.Name
                                </button>
                            </li>
                        }
                    }
                }
            </ol>
        </nav>
        @if (_listing is not null && _listing.Items.Count > 0)
        {
            <FolderSearchBar Value="@_filterText"
                              ValueChanged="OnFilterChanged"
                              Placeholder="Filter by name"
                              AriaLabel="Filter items by name" />
        }
        @if (_listing?.CanCreateFolder == true)
        {
            <div class="d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="btn btn-primary rounded-circle d-inline-flex align-items-center justify-content-center"
                            style="width:44px;height:44px;"
                            type="button"
                            disabled="@_operationPending"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            aria-label="Create">
                        <i class="bi bi-plus fs-4 lh-1" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <button class="dropdown-item d-flex align-items-center"
                                    type="button"
                                    disabled="@_operationPending"
                                    data-bs-toggle="modal"
                                    data-bs-target="#@CreateModalId">
                                <i class="bi bi-folder-plus me-2" aria-hidden="true"></i>
                                Folder
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center"
                                    type="button"
                                    disabled="@_operationPending"
                                    @onclick="StartCreateTextFile"
                                    data-bs-toggle="modal"
                                    data-bs-target="#@CreateFileModalId">
                                <i class="bi bi-file-earmark-text me-2" aria-hidden="true"></i>
                                Text file (.txt)
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item d-flex align-items-center"
                                    type="button"
                                    disabled="@_operationPending"
                                    @onclick="StartCreateMarkdownFile"
                                    data-bs-toggle="modal"
                                    data-bs-target="#@CreateFileModalId">
                                <i class="bi bi-markdown me-2" aria-hidden="true"></i>
                                Markdown file (.md)
                            </button>
                        </li>
                    </ul>
                </div>
                <button class="btn btn-secondary rounded-circle d-inline-flex align-items-center justify-content-center"
                        style="width:44px;height:44px;"
                        type="button"
                        disabled="@_operationPending"
                        @onclick="TriggerUpload"
                        aria-label="Upload">
                    <i class="bi bi-upload fs-5 lh-1" aria-hidden="true"></i>
                </button>
                <InputFile @ref="_fileInput" OnChange="OnFilesSelected" multiple class="visually-hidden" aria-hidden="true" />
            </div>
        }
        @if (Category == "trash")
        {
            <button class="btn btn-danger d-inline-flex align-items-center gap-2"
                    type="button"
                    disabled="@(_operationPending || _listing is null || _listing.Items.Count == 0)"
                    aria-label="Empty Trash"
                    @onclick="StartEmptyTrash">
                <i class="bi bi-recycle" aria-hidden="true"></i>
                Empty Trash
            </button>
        }
    </div>

    @if (_uploads.Count > 0)
    {
        <div class="list-group list-group-flush border-top" aria-label="Upload status">
            @foreach (var upload in _uploads)
            {
                <div class="list-group-item d-flex align-items-center justify-content-between gap-2">
                    <span class="text-truncate">@upload.Name</span>
                    @switch (upload.Status)
                    {
                        case UploadStatus.Uploading:
                            <span class="badge text-bg-secondary d-inline-flex align-items-center gap-1">
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                Uploading
                            </span>
                            break;
                        case UploadStatus.Done:
                            <span class="badge text-bg-success">Done</span>
                            break;
                        case UploadStatus.Error:
                            <span class="badge text-bg-danger" title="@upload.ErrorMessage">Error</span>
                            break;
                    }
                </div>
            }
        </div>
    }

    @if (_error is not null)
    {
        <div class="alert alert-danger m-3" role="alert">@_error</div>
    }

    @if (_isLoading)
    {
        <div class="card-body d-flex flex-column align-items-center gap-2 py-5 text-center text-body-secondary" role="status" aria-live="polite">
            <span class="spinner-border text-primary" aria-hidden="true"></span>
            <strong class="fs-5 text-body">Loading @Title</strong>
            <span>Reading the local archive.</span>
        </div>
    }
    else if (_listing is null || _listing.Items.Count == 0)
    {
        <div class="card-body d-flex flex-column align-items-center gap-2 py-5 text-center text-body-secondary" role="status" aria-live="polite">
            <i class="bi @Icon fs-2 text-primary" aria-hidden="true"></i>
            <strong class="fs-5 text-body">No items here</strong>
            <span>This folder is empty.</span>
        </div>
    }
    else if (_filteredItems.Count == 0)
    {
        <div class="card-body d-flex flex-column align-items-center gap-2 py-5 text-center text-body-secondary" role="status" aria-live="polite">
            <i class="bi bi-search fs-2 text-primary" aria-hidden="true"></i>
            <strong class="fs-5 text-body">No matches</strong>
            <span>No items match "@_filterText".</span>
        </div>
    }
    else
    {
        <p class="small text-body-secondary border-bottom mb-0 px-3 py-2" role="status">
            @_filteredItems.Count @(_filteredItems.Count == 1 ? "item" : "items")
        </p>
        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 p-3" aria-label="@Title">
            @foreach (var item in _filteredItems)
            {
                var selected = IsSelected(item);
                <div class="col">
                    <div class="card h-100 position-relative overflow-hidden @(selected ? "border-primary border-2" : null)"
                         @onmouseenter="() => StartPreview(item)"
                         @onmouseleave="ClearPreview">
                        @if (selected)
                        {
                            <span class="badge text-bg-primary position-absolute top-0 start-0 z-1 m-2">
                                <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>Selected
                            </span>
                        }
                        <div class="dropdown position-absolute top-0 end-0 z-2 m-2" @onclick:stopPropagation="true">
                            <button class="btn btn-outline-secondary btn-sm rounded-circle d-inline-flex align-items-center justify-content-center bg-body bg-opacity-75"
                                    style="width:40px;height:40px;"
                                    type="button"
                                    disabled="@_operationPending"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    aria-label="Actions for @item.Name">
                                <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (item.Kind == ArchiveItemKind.Folder && item.HasPlayableMedia)
                                {
                                    <li>
                                        <button class="dropdown-item d-flex align-items-center"
                                                type="button"
                                                disabled="@_operationPending"
                                                @onclick="() => PlayAsPlaylist(item)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi bi-collection-play me-2" aria-hidden="true"></i>
                                            Play as a Playlist
                                        </button>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                <li>
                                    <button class="dropdown-item d-flex align-items-center"
                                            type="button"
                                            disabled="@_operationPending"
                                            @onclick="() => StartRename(item)"
                                            @onclick:stopPropagation="true">
                                        <i class="bi bi-pencil me-2" aria-hidden="true"></i>
                                        Rename
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item d-flex align-items-center"
                                            type="button"
                                            disabled="@(_operationPending || _folderChoices.Count == 0)"
                                            @onclick="() => StartMove(item)"
                                            @onclick:stopPropagation="true">
                                        <i class="bi bi-folder-symlink me-2" aria-hidden="true"></i>
                                        Move
                                    </button>
                                </li>
                                @if (Category != "trash")
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <button class="dropdown-item text-danger d-flex align-items-center"
                                                type="button"
                                                disabled="@_operationPending"
                                                @onclick="() => DeleteAsync(item)"
                                                @onclick:stopPropagation="true">
                                            <i class="bi bi-trash3 me-2" aria-hidden="true"></i>
                                            Move to Trash
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                        <button class="@CardButtonCssClass(item)"
                                type="button"
                                aria-pressed="@((item.IsVideo || item.IsMusic) ? selected : null)"
                                @onclick="() => ActivateAsync(item)">
                            @if (item.IsMusic)
                            {
                                <span class="archive-cover-tile ratio ratio-1x1 bg-body-tertiary w-100" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(item.AlbumCoverUrl))
                                    {
                                        <img src="@item.AlbumCoverUrl" alt="" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <span class="d-flex align-items-center justify-content-center">
                                            <i class="bi bi-music-note-beamed display-1 lh-1 text-primary" aria-hidden="true"></i>
                                        </span>
                                    }
                                    <span class="archive-cover-overlay position-absolute start-0 end-0 bottom-0 d-flex flex-column gap-1 text-start p-3">
                                        <span class="fw-semibold text-truncate">@FormatDisplayName(item)</span>
                                        <span class="small d-flex gap-2 flex-wrap">
                                            <span class="text-nowrap">@FormatDuration(item.DurationSeconds)</span>
                                            <span class="text-nowrap">@FormatExtension(item.Extension)</span>
                                        </span>
                                    </span>
                                </span>
                            }
                            else if (item.IsImage)
                            {
                                <span class="archive-cover-tile ratio ratio-1x1 bg-body-tertiary w-100" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <span class="d-flex align-items-center justify-content-center">
                                            <i class="bi bi-image display-1 lh-1 text-primary" aria-hidden="true"></i>
                                        </span>
                                    }
                                    <span class="archive-cover-overlay position-absolute start-0 end-0 bottom-0 d-flex flex-column gap-1 text-start p-3">
                                        <span class="fw-semibold text-truncate">@FormatDisplayName(item)</span>
                                        <span class="small d-flex gap-2 flex-wrap">
                                            <span class="text-nowrap">@FormatSize(item.SizeBytes)</span>
                                            <span class="text-nowrap">@FormatExtension(item.Extension)</span>
                                        </span>
                                    </span>
                                </span>
                            }
                            else if (item.IsBook)
                            {
                                <span class="archive-cover-tile book-cover-tile ratio w-100" style="--bs-aspect-ratio: 150%;" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(item.BookCoverUrl))
                                    {
                                        <img src="@item.BookCoverUrl" alt="" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <span class="d-flex align-items-center justify-content-center h-100">
                                            <i class="bi bi-book display-1 lh-1 text-primary" aria-hidden="true"></i>
                                        </span>
                                    }
                                    <span class="archive-cover-overlay position-absolute start-0 end-0 bottom-0 d-flex flex-column gap-1 text-start p-3">
                                        <span class="fw-semibold text-truncate">@(item.BookTitle ?? FormatDisplayName(item))</span>
                                        <span class="small d-flex gap-2 flex-wrap">
                                            @if (!string.IsNullOrWhiteSpace(item.BookAuthor))
                                            {
                                                <span class="text-truncate">@item.BookAuthor</span>
                                            }
                                            <span class="text-nowrap">@FormatExtension(item.Extension)</span>
                                        </span>
                                    </span>
                                </span>
                            }
                            else if (item.IsVideo)
                            {
                                <span class="ratio ratio-16x9 bg-body-tertiary border-bottom w-100" aria-hidden="true">
                                    @if (item.Id == _previewingVideoId && item.HoverPreviewState == HoverPreviewState.Ready && !string.IsNullOrEmpty(item.HoverPreviewUrl))
                                    {
                                        <video src="@item.HoverPreviewUrl"
                                               poster="@item.ThumbnailUrl"
                                               class="w-100 h-100 object-fit-cover"
                                               autoplay
                                               muted
                                               loop
                                               playsinline>
                                        </video>
                                    }
                                    else if (item.ThumbnailState == ThumbnailState.Ready && !string.IsNullOrEmpty(item.ThumbnailUrl))
                                    {
                                        <img src="@item.ThumbnailUrl" alt="" class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <span class="d-flex align-items-center justify-content-center">
                                            <i class="bi bi-film display-1 lh-1 text-body-secondary" aria-hidden="true"></i>
                                        </span>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="ratio ratio-16x9 bg-body-tertiary border-bottom w-100" aria-hidden="true">
                                    <span class="d-flex align-items-center justify-content-center">
                                    <i class="bi @(item.Kind == ArchiveItemKind.Folder ? "bi-folder-fill text-primary" : FileIcon(item)) display-5" aria-hidden="true"></i>
                                    </span>
                                </span>
                            }
                            @if (!item.IsMusic && !item.IsImage && !item.IsBook)
                            {
                                <span class="card-body d-flex flex-column w-100 text-center">
                                    <span class="fw-semibold text-break">@item.Name</span>
                                    @if (item.Kind == ArchiveItemKind.File)
                                    {
                                        <span class="card-text d-flex justify-content-center gap-2 text-body-secondary mt-2 flex-wrap" style="font-size: 0.7rem;">
                                            @if (item.IsVideo)
                                            {
                                                <span class="text-nowrap">@FormatDuration(item.DurationSeconds)</span>
                                                <span class="text-nowrap">@FormatSize(item.SizeBytes)</span>
                                                <span class="text-nowrap">@FormatResolution(item.Width, item.Height)</span>
                                                <span class="text-nowrap">@FormatDimensions(item.Width, item.Height)</span>
                                                <span class="text-nowrap">@FormatExtension(item.Extension)</span>
                                            }
                                            else
                                            {
                                                <span class="text-nowrap">@FormatSize(item.SizeBytes)</span>
                                                <span class="text-nowrap">@FormatExtension(item.Extension)</span>
                                            }
                                        </span>
                                    }
                                </span>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</section>

@if (_imageViewerStartId is not null)
{
    <ImageCarouselViewer Images="_imageViewerImages" Category="@Category" StartId="_imageViewerStartId" OnExit="CloseImageViewer" />
}

@if (_listing?.CanCreateFolder == true)
{
    <div class="modal fade" id="@CreateModalId" tabindex="-1" aria-labelledby="@CreateModalLabelId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <EditForm Model="_createFolder" OnValidSubmit="CreateFolderAsync">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="@CreateModalLabelId">New folder</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" disabled="@_operationPending"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="@CreateInputId">Folder name</label>
                        <InputText id="@CreateInputId" class="form-control" @bind-Value="_createFolder.Name" />
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal" disabled="@_operationPending">Cancel</button>
                        <button class="btn btn-primary d-inline-flex align-items-center" type="submit" disabled="@_operationPending">
                            <i class="bi bi-folder-plus me-2" aria-hidden="true"></i>
                            Create
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (_listing?.CanCreateFolder == true)
{
    <div class="modal fade" id="@CreateFileModalId" tabindex="-1" aria-labelledby="@CreateFileModalLabelId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <EditForm Model="_createFile" OnValidSubmit="CreateFileAsync">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="@CreateFileModalLabelId">New @(_createFile.Extension == ".md" ? "Markdown" : "Text") file</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" disabled="@_operationPending"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="@CreateFileInputId">File name</label>
                        <div class="input-group">
                            <InputText id="@CreateFileInputId" class="form-control" @bind-Value="_createFile.Name" />
                            <span class="input-group-text">@_createFile.Extension</span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal" disabled="@_operationPending">Cancel</button>
                        <button class="btn btn-primary d-inline-flex align-items-center" type="submit" disabled="@_operationPending">
                            <i class="bi bi-file-earmark-plus me-2" aria-hidden="true"></i>
                            Create
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (_moving is not null)
{
    <div class="modal fade show d-block" tabindex="-1" aria-labelledby="@MoveModalLabelId" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="@MoveModalLabelId">Move @_moving.Name</h1>
                    <button type="button" class="btn-close" aria-label="Close" disabled="@_operationPending" @onclick="CancelDialogs"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="@MoveInputId">Move to</label>
                    <select id="@MoveInputId" class="form-select" @bind="_moveDestinationId">
                        <option value="">@Title root</option>
                        @foreach (var folder in _folderChoices)
                        {
                            <option value="@folder.Id">@folder.Name</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" disabled="@_operationPending" @onclick="CancelDialogs">Cancel</button>
                    <button class="btn btn-primary" type="button" disabled="@_operationPending" @onclick="MoveAsync">Move</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_renaming is not null)
{
    <div class="modal fade show d-block" tabindex="-1" aria-labelledby="@RenameModalLabelId" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="@RenameModalLabelId">Rename @_renaming.Name</h1>
                    <button type="button" class="btn-close" aria-label="Close" disabled="@_operationPending" @onclick="CancelDialogs"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="@RenameInputId">Name</label>
                    <InputText id="@RenameInputId" class="form-control" @bind-Value="_renameName" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" disabled="@_operationPending" @onclick="CancelDialogs">Cancel</button>
                    <button class="btn btn-primary" type="button" disabled="@_operationPending" @onclick="RenameAsync">Save</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_confirmingEmptyTrash)
{
    <div class="modal fade show d-block" tabindex="-1" aria-labelledby="@EmptyTrashModalLabelId" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="@EmptyTrashModalLabelId">Empty Trash</h1>
                    <button type="button" class="btn-close" aria-label="Close" disabled="@_operationPending" @onclick="CancelDialogs"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">This permanently deletes all items in Trash. This cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" disabled="@_operationPending" @onclick="CancelDialogs">Cancel</button>
                    <button class="btn btn-danger" type="button" disabled="@_operationPending" @onclick="EmptyTrashAsync">Empty Trash</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter] public EventCallback<ArchiveItemDto> OnVideoSelected { get; set; }
    [Parameter] public EventCallback<ArchiveItemDto> OnBookSelected { get; set; }
    [Parameter] public EventCallback<ArchiveItemDto> OnTextDocumentSelected { get; set; }
    [Parameter] public EventCallback<ArchiveItemDto> OnPdfDocumentSelected { get; set; }

    private readonly FolderForm _createFolder = new();
    private readonly FileForm _createFile = new();
    private readonly List<UploadItem> _uploads = [];
    private InputFile? _fileInput;
    private ArchiveListingDto? _listing;
    private ArchiveItemDto? _renaming;
    private ArchiveItemDto? _moving;
    private bool _confirmingEmptyTrash;
    private List<ArchiveItemDto> _folderChoices = [];
    private string _renameName = string.Empty;
    private string? _moveDestinationId;
    private string? _error;
    private IJSObjectReference? _bootstrapModule;
    private string? _previewingVideoId;
    private List<ArchiveItemDto> _imageViewerImages = [];
    private string? _imageViewerStartId;
    private CancellationTokenSource? _mediaPollingCts;
    private bool _isLoading = true;
    private bool _operationPending;
    private string _filterText = string.Empty;

    private IReadOnlyList<ArchiveItemDto> _filteredItems =>
        string.IsNullOrWhiteSpace(_filterText)
            ? _listing?.Items ?? []
            : (_listing?.Items ?? []).Where(item => item.Name.Contains(_filterText, StringComparison.OrdinalIgnoreCase)).ToList();
    private string HeadingId => $"archive-{Category}-heading";
    private string CreateModalId => $"archive-{Category}-create-modal";
    private string CreateModalLabelId => $"archive-{Category}-create-modal-label";
    private string CreateInputId => $"archive-{Category}-create-folder";
    private string CreateFileModalId => $"archive-{Category}-create-file-modal";
    private string CreateFileModalLabelId => $"archive-{Category}-create-file-modal-label";
    private string CreateFileInputId => $"archive-{Category}-create-file";
    private string MoveModalLabelId => $"archive-{Category}-move-modal-label";
    private string RenameModalLabelId => $"archive-{Category}-rename-modal-label";
    private string EmptyTrashModalLabelId => $"archive-{Category}-empty-trash-modal-label";
    private string RenameInputId => $"archive-{Category}-rename";
    private string MoveInputId => $"archive-{Category}-move";
    private string ArchiveStreamBasePath => $"api/archive/{Uri.EscapeDataString(Category)}/items";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync(null);
    }

    protected override void OnInitialized()
    {
        PlayerState.StateChanged += HandlePlayerStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _bootstrapModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/bootstrapInterop.js");
        }
        catch (JSException)
        {
            // The modal remains usable with Bootstrap's data attributes if JS interop import fails.
        }
    }

    private void OnFilterChanged(string value) => _filterText = value;

    private async Task LoadAsync(string? folderId, bool restartPolling = true, bool showLoading = true)
    {
        _isLoading = showLoading;
        _error = null;
        if (showLoading)
        {
            _filterText = string.Empty;
        }
        try
        {
            var url = $"api/archive/{Category}/items";
            if (!string.IsNullOrWhiteSpace(folderId))
            {
                url += $"?folderId={Uri.EscapeDataString(folderId)}";
            }

            _listing = await Http.GetFromJsonAsync<ArchiveListingDto>(url);
            _folderChoices = _listing?.Items.Where(item => item.Kind == ArchiveItemKind.Folder).ToList() ?? [];
            if (restartPolling)
            {
                RestartMediaPollingIfNeeded();
            }
        }
        catch (HttpRequestException)
        {
            _error = "The archive folder could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void PlayAsPlaylist(ArchiveItemDto item) =>
        Navigation.NavigateTo($"/playlist/{Category}/{Uri.EscapeDataString(item.Id)}");

    private async Task ActivateAsync(ArchiveItemDto item)
    {
        if (item.Kind == ArchiveItemKind.Folder)
        {
            await LoadAsync(item.Id);
            return;
        }

        if (item.IsVideo && OnVideoSelected.HasDelegate)
        {
            await OnVideoSelected.InvokeAsync(item);
            return;
        }

        if (item.IsBook)
        {
            if (OnBookSelected.HasDelegate)
            {
                await OnBookSelected.InvokeAsync(item);
            }

            return;
        }

        if (item.IsTextDocument)
        {
            if (OnTextDocumentSelected.HasDelegate)
            {
                await OnTextDocumentSelected.InvokeAsync(item);
            }

            return;
        }

        if (item.IsPdfDocument)
        {
            if (OnPdfDocumentSelected.HasDelegate)
            {
                await OnPdfDocumentSelected.InvokeAsync(item);
            }

            return;
        }

        if (item.IsVideo)
        {
            await SelectVideoAsync(item);
        }
        else if (item.IsMusic)
        {
            PlayerState.SelectMusic(item, _listing?.Items ?? []);
        }
        else if (item.IsImage)
        {
            OpenImageViewer(item);
        }
    }

    private void OpenImageViewer(ArchiveItemDto item)
    {
        _imageViewerImages = (_listing?.Items ?? [])
            .Where(candidate => candidate.IsImage)
            .ToList();
        _imageViewerStartId = item.Id;
    }

    private void CloseImageViewer()
    {
        _imageViewerImages = [];
        _imageViewerStartId = null;
    }

    private async Task SelectVideoAsync(ArchiveItemDto item)
    {
        if (!string.Equals(Category, "videos", StringComparison.OrdinalIgnoreCase))
        {
            PlayerState.SelectArchiveVideo(Category, item);
            return;
        }

        _error = null;

        try
        {
            using var response = await Http.PostAsync("api/videos/scan", content: null);
            if (!response.IsSuccessStatusCode)
            {
                _error = "The video could not be prepared for playback.";
                return;
            }

            var videos = await response.Content.ReadFromJsonAsync<List<VideoItemDto>>() ?? [];
            var video = videos.FirstOrDefault(video => video.Id == item.Id);
            if (video is null)
            {
                _error = "The selected file is not available to the video player yet.";
                return;
            }

            PlayerState.SelectVideo(video);
        }
        catch (HttpRequestException)
        {
            _error = "The video could not be reached.";
        }
    }

    private bool IsSelected(ArchiveItemDto item)
    {
        if (!(item.IsVideo || item.IsMusic) || !string.Equals(PlayerState.SelectedId, item.Id, StringComparison.Ordinal))
        {
            return false;
        }

        var expectedStreamBasePath = string.Equals(Category, "videos", StringComparison.OrdinalIgnoreCase)
            ? PersistentPlayerState.VideoStreamBasePath
            : item.IsMusic
                ? GetStreamBasePath(item.AudioUrl)
            : ArchiveStreamBasePath;
        return string.Equals(PlayerState.StreamBasePath, expectedStreamBasePath, StringComparison.Ordinal);
    }

    private void HandlePlayerStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CreateFolderAsync()
    {
        var folderName = _createFolder.Name.Trim();
        var listing = await SendMutationAsync(() => Http.PostAsJsonAsync(
            $"api/archive/{Category}/folders",
            new CreateFolderRequest(_listing?.CurrentFolderId, _createFolder.Name)));
        _createFolder.Name = string.Empty;

        var createdFolder = listing?.Items.FirstOrDefault(item =>
            item.Kind == ArchiveItemKind.Folder &&
            string.Equals(item.Name, folderName, StringComparison.OrdinalIgnoreCase));
        if (createdFolder is null)
        {
            return;
        }

        await HideCreateModalAsync();
        await LoadAsync(createdFolder.Id);
    }

    private void StartCreateTextFile() => StartCreateFile(".txt");

    private void StartCreateMarkdownFile() => StartCreateFile(".md");

    private void StartCreateFile(string extension)
    {
        _createFile.Extension = extension;
        _createFile.Name = string.Empty;
    }

    private async Task CreateFileAsync()
    {
        var fileName = _createFile.Name.Trim();
        var extension = _createFile.Extension;
        var listing = await SendMutationAsync(() => Http.PostAsJsonAsync(
            $"api/archive/{Category}/files",
            new CreateFileRequest(_listing?.CurrentFolderId, _createFile.Name, extension)));
        _createFile.Name = string.Empty;

        var createdFile = listing?.Items.FirstOrDefault(item =>
            item.Kind == ArchiveItemKind.File &&
            string.Equals(item.Name, $"{fileName}{extension}", StringComparison.OrdinalIgnoreCase));
        if (createdFile is null)
        {
            return;
        }

        await HideCreateFileModalAsync();
        if (OnTextDocumentSelected.HasDelegate)
        {
            await OnTextDocumentSelected.InvokeAsync(createdFile);
        }
    }

    private async Task TriggerUpload()
    {
        if (_fileInput?.Element is not { } element || _bootstrapModule is null)
        {
            return;
        }

        try
        {
            await _bootstrapModule.InvokeVoidAsync("clickElement", element);
        }
        catch (JSException)
        {
        }
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(e.FileCount))
        {
            var upload = new UploadItem(file.Name);
            _uploads.Add(upload);
            StateHasChanged();

            try
            {
                using var content = new MultipartFormDataContent();
                await using var stream = file.OpenReadStream(MaxUploadFileSizeBytes);
                using var streamContent = new StreamContent(stream);
                content.Add(streamContent, "file", file.Name);

                var url = $"api/archive/{Category}/upload";
                if (!string.IsNullOrWhiteSpace(_listing?.CurrentFolderId))
                {
                    url += $"?parentId={Uri.EscapeDataString(_listing!.CurrentFolderId!)}";
                }

                using var response = await Http.PostAsync(url, content);
                if (response.IsSuccessStatusCode)
                {
                    upload.Status = UploadStatus.Done;
                    await LoadAsync(_listing?.CurrentFolderId, restartPolling: true, showLoading: false);
                }
                else
                {
                    upload.Status = UploadStatus.Error;
                    upload.ErrorMessage = response.StatusCode == System.Net.HttpStatusCode.Conflict
                        ? "An item with that name already exists."
                        : "This file type is not supported or could not be uploaded.";
                }
            }
            catch (Exception exception) when (exception is HttpRequestException or IOException)
            {
                upload.Status = UploadStatus.Error;
                upload.ErrorMessage = "The upload could not reach the server.";
            }

            StateHasChanged();
        }
    }

    private void StartRename(ArchiveItemDto item)
    {
