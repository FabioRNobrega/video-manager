@inject HttpClient Http
@inject IJSRuntime JS
@inject PersistentPlayerState PlayerState
@implements IDisposable

<section class="card overflow-hidden" aria-labelledby="@HeadingId">
    <div class="card-header d-flex align-items-center justify-content-between gap-3 flex-wrap">
        <nav id="@HeadingId" aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                @if (_listing is null || _listing.Breadcrumbs.Count == 0)
                {
                    <li class="breadcrumb-item active" aria-current="page">@Title</li>
                }
                else
                {
                    <li class="breadcrumb-item">
                        <button class="btn btn-link p-0 align-baseline" type="button" disabled="@_operationPending" @onclick="() => LoadAsync(null)">
                            @_listing.DisplayName
                        </button>
                    </li>
                    @foreach (var breadcrumb in _listing.Breadcrumbs)
                    {
                        var isCurrent = breadcrumb == _listing.Breadcrumbs[^1];
                        if (isCurrent)
                        {
                            <li class="breadcrumb-item active text-break" aria-current="page">@breadcrumb.Name</li>
                        }
                        else
                        {
                            <li class="breadcrumb-item">
                                <button class="btn btn-link p-0 align-baseline text-break"
                                        type="button"
                                        disabled="@_operationPending"
                                        @onclick="() => LoadAsync(breadcrumb.FolderId)">
                                    @breadcrumb.Name
                                </button>
                            </li>
                        }
                    }
                }
            </ol>
        </nav>
        @if (_listing?.CanCreateFolder == true)
        {
            <button class="btn btn-primary rounded-circle d-inline-flex align-items-center justify-content-center"
                    style="width:44px;height:44px;"
                    type="button"
                    disabled="@_operationPending"
                    data-bs-toggle="modal"
                    data-bs-target="#@CreateModalId"
                    aria-label="Create folder">
                <i class="bi bi-plus fs-4 lh-1" aria-hidden="true"></i>
            </button>
        }
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger m-3" role="alert">@_error</div>
    }

    @if (_isLoading)
    {
        <div class="card-body d-flex flex-column align-items-center gap-2 py-5 text-center text-body-secondary" role="status" aria-live="polite">
            <span class="spinner-border text-primary" aria-hidden="true"></span>
            <strong class="fs-5 text-body">Loading @Title</strong>
            <span>Reading the local archive.</span>
        </div>
    }
    else if (_listing is null || _listing.Items.Count == 0)
    {
        <div class="card-body d-flex flex-column align-items-center gap-2 py-5 text-center text-body-secondary" role="status" aria-live="polite">
            <i class="bi @Icon fs-2 text-primary" aria-hidden="true"></i>
            <strong class="fs-5 text-body">No items here</strong>
            <span>This folder is empty.</span>
        </div>
    }
    else
    {
        <p class="small text-body-secondary border-bottom mb-0 px-3 py-2" role="status">
            @_listing.Items.Count @(_listing.Items.Count == 1 ? "item" : "items")
        </p>
        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 p-3" aria-label="@Title">
            @foreach (var item in _listing.Items)
            {
                var selected = IsSelected(item);
                <div class="col">
                    <div class="card h-100 position-relative @(selected ? "border-primary border-2" : null)">
                        @if (selected)
                        {
                            <span class="badge text-bg-primary position-absolute top-0 end-0 z-1 m-2">
                                <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i>Selected
                            </span>
                        }
                        <button class="card-body btn btn-link text-decoration-none text-body d-flex flex-column align-items-center gap-2"
                                type="button"
                                aria-pressed="@(item.IsVideo ? selected : null)"
                                @onclick="() => ActivateAsync(item)">
                            <i class="bi @(item.Kind == ArchiveItemKind.Folder ? "bi-folder-fill text-primary" : FileIcon(item)) display-5" aria-hidden="true"></i>
                            <span class="fw-semibold text-break text-center">@item.Name</span>
                            @if (item.Kind == ArchiveItemKind.File)
                            {
                                <span class="small text-body-secondary">@FormatSize(item.SizeBytes)</span>
                            }
                        </button>
                        <div class="card-footer d-flex gap-2 justify-content-center">
                            <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@_operationPending" title="Rename" aria-label="Rename @item.Name" @onclick="() => StartRename(item)">
                                <i class="bi bi-pencil" aria-hidden="true"></i>
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" type="button" disabled="@(_operationPending || _folderChoices.Count == 0)" title="Move" aria-label="Move @item.Name" @onclick="() => StartMove(item)">
                                <i class="bi bi-folder-symlink" aria-hidden="true"></i>
                            </button>
                            @if (Category != "trash")
                            {
                                <button class="btn btn-outline-danger btn-sm" type="button" disabled="@_operationPending" title="Move to Trash" aria-label="Move @item.Name to Trash" @onclick="() => DeleteAsync(item)">
                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@if (_listing?.CanCreateFolder == true)
{
    <div class="modal fade" id="@CreateModalId" tabindex="-1" aria-labelledby="@CreateModalLabelId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <EditForm Model="_createFolder" OnValidSubmit="CreateFolderAsync">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="@CreateModalLabelId">New folder</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" disabled="@_operationPending"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="@CreateInputId">Folder name</label>
                        <InputText id="@CreateInputId" class="form-control" @bind-Value="_createFolder.Name" />
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal" disabled="@_operationPending">Cancel</button>
                        <button class="btn btn-primary d-inline-flex align-items-center" type="submit" disabled="@_operationPending">
                            <i class="bi bi-folder-plus me-2" aria-hidden="true"></i>
                            Create
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (_moving is not null)
{
    <div class="modal fade show d-block" tabindex="-1" aria-labelledby="@MoveModalLabelId" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="@MoveModalLabelId">Move @_moving.Name</h1>
                    <button type="button" class="btn-close" aria-label="Close" disabled="@_operationPending" @onclick="CancelDialogs"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="@MoveInputId">Move to</label>
                    <select id="@MoveInputId" class="form-select" @bind="_moveDestinationId">
                        <option value="">@Title root</option>
                        @foreach (var folder in _folderChoices)
                        {
                            <option value="@folder.Id">@folder.Name</option>
                        }
                    </select>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" disabled="@_operationPending" @onclick="CancelDialogs">Cancel</button>
                    <button class="btn btn-primary" type="button" disabled="@_operationPending" @onclick="MoveAsync">Move</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_renaming is not null)
{
    <div class="modal fade show d-block" tabindex="-1" aria-labelledby="@RenameModalLabelId" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="@RenameModalLabelId">Rename @_renaming.Name</h1>
                    <button type="button" class="btn-close" aria-label="Close" disabled="@_operationPending" @onclick="CancelDialogs"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="@RenameInputId">Name</label>
                    <InputText id="@RenameInputId" class="form-control" @bind-Value="_renameName" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" disabled="@_operationPending" @onclick="CancelDialogs">Cancel</button>
                    <button class="btn btn-primary" type="button" disabled="@_operationPending" @onclick="RenameAsync">Save</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter, EditorRequired] public string Category { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;
    [Parameter] public EventCallback<ArchiveItemDto> OnVideoSelected { get; set; }

    private readonly FolderForm _createFolder = new();
    private ArchiveListingDto? _listing;
    private ArchiveItemDto? _renaming;
    private ArchiveItemDto? _moving;
    private List<ArchiveItemDto> _folderChoices = [];
    private string _renameName = string.Empty;
    private string? _moveDestinationId;
    private string? _error;
    private IJSObjectReference? _bootstrapModule;
    private bool _isLoading = true;
    private bool _operationPending;
    private string HeadingId => $"archive-{Category}-heading";
    private string CreateModalId => $"archive-{Category}-create-modal";
    private string CreateModalLabelId => $"archive-{Category}-create-modal-label";
    private string CreateInputId => $"archive-{Category}-create-folder";
    private string MoveModalLabelId => $"archive-{Category}-move-modal-label";
    private string RenameModalLabelId => $"archive-{Category}-rename-modal-label";
    private string RenameInputId => $"archive-{Category}-rename";
    private string MoveInputId => $"archive-{Category}-move";
    private string ArchiveStreamBasePath => $"api/archive/{Uri.EscapeDataString(Category)}/items";

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync(null);
    }

    protected override void OnInitialized()
    {
        PlayerState.StateChanged += HandlePlayerStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _bootstrapModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/bootstrapInterop.js");
        }
        catch (JSException)
        {
            // The modal remains usable with Bootstrap's data attributes if JS interop import fails.
        }
    }

    private async Task LoadAsync(string? folderId)
    {
        _isLoading = true;
        _error = null;
        try
        {
            var url = $"api/archive/{Category}/items";
            if (!string.IsNullOrWhiteSpace(folderId))
            {
                url += $"?folderId={Uri.EscapeDataString(folderId)}";
            }

            _listing = await Http.GetFromJsonAsync<ArchiveListingDto>(url);
            _folderChoices = _listing?.Items.Where(item => item.Kind == ArchiveItemKind.Folder).ToList() ?? [];
        }
        catch (HttpRequestException)
        {
            _error = "The archive folder could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ActivateAsync(ArchiveItemDto item)
    {
        if (item.Kind == ArchiveItemKind.Folder)
        {
            await LoadAsync(item.Id);
            return;
        }

        if (item.IsVideo && OnVideoSelected.HasDelegate)
        {
            await OnVideoSelected.InvokeAsync(item);
            return;
        }

        if (item.IsVideo)
        {
            await SelectVideoAsync(item);
        }
    }

    private async Task SelectVideoAsync(ArchiveItemDto item)
    {
        if (!string.Equals(Category, "videos", StringComparison.OrdinalIgnoreCase))
        {
            PlayerState.SelectArchiveVideo(Category, item);
            return;
        }

        _error = null;

        try
        {
            using var response = await Http.PostAsync("api/videos/scan", content: null);
            if (!response.IsSuccessStatusCode)
            {
                _error = "The video could not be prepared for playback.";
                return;
            }

            var videos = await response.Content.ReadFromJsonAsync<List<VideoItemDto>>() ?? [];
            var video = videos.FirstOrDefault(video => video.Id == item.Id);
            if (video is null)
            {
                _error = "The selected file is not available to the video player yet.";
                return;
            }

            PlayerState.SelectVideo(video);
        }
        catch (HttpRequestException)
        {
            _error = "The video could not be reached.";
        }
    }

    private bool IsSelected(ArchiveItemDto item)
    {
        if (!item.IsVideo || !string.Equals(PlayerState.SelectedId, item.Id, StringComparison.Ordinal))
        {
            return false;
        }

        var expectedStreamBasePath = string.Equals(Category, "videos", StringComparison.OrdinalIgnoreCase)
            ? PersistentPlayerState.VideoStreamBasePath
            : ArchiveStreamBasePath;
        return string.Equals(PlayerState.StreamBasePath, expectedStreamBasePath, StringComparison.Ordinal);
    }

    private void HandlePlayerStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CreateFolderAsync()
    {
        var folderName = _createFolder.Name.Trim();
        var listing = await SendMutationAsync(() => Http.PostAsJsonAsync(
            $"api/archive/{Category}/folders",
            new CreateFolderRequest(_listing?.CurrentFolderId, _createFolder.Name)));
        _createFolder.Name = string.Empty;

        var createdFolder = listing?.Items.FirstOrDefault(item =>
            item.Kind == ArchiveItemKind.Folder &&
            string.Equals(item.Name, folderName, StringComparison.OrdinalIgnoreCase));
        if (createdFolder is null)
        {
            return;
        }

        await HideCreateModalAsync();
        await LoadAsync(createdFolder.Id);
    }

    private void StartRename(ArchiveItemDto item)
    {
        _renaming = item;
        _renameName = item.Name;
        _moving = null;
    }

    private void StartMove(ArchiveItemDto item)
    {
        _moving = item;
        _moveDestinationId = null;
        _renaming = null;
    }

    private async Task RenameAsync()
    {
        if (_renaming is null)
        {
            return;
        }

        var id = _renaming.Id;
        _ = await SendMutationAsync(() => Http.PatchAsJsonAsync(
            $"api/archive/{Category}/items/{Uri.EscapeDataString(id)}/name",
            new RenameArchiveItemRequest(_renameName)));
        CancelDialogs();
    }

    private async Task MoveAsync()
    {
        if (_moving is null)
        {
            return;
        }

        var id = _moving.Id;
        _ = await SendMutationAsync(() => Http.PatchAsJsonAsync(
            $"api/archive/{Category}/items/{Uri.EscapeDataString(id)}/location",
            new MoveArchiveItemRequest(string.IsNullOrWhiteSpace(_moveDestinationId) ? null : _moveDestinationId)));
        CancelDialogs();
    }

    private async Task DeleteAsync(ArchiveItemDto item) =>
        _ = await SendMutationAsync(() => Http.DeleteAsync($"api/archive/{Category}/items/{Uri.EscapeDataString(item.Id)}"));

    private async Task<ArchiveListingDto?> SendMutationAsync(Func<Task<HttpResponseMessage>> action)
    {
        _operationPending = true;
        _error = null;
        try
        {
            using var response = await action();
            if (!response.IsSuccessStatusCode)
            {
                _error = response.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "That change conflicts with an existing item."
                    : "The archive change could not be saved.";
                return null;
            }

            _listing = await response.Content.ReadFromJsonAsync<ArchiveListingDto>();
            _folderChoices = _listing?.Items.Where(item => item.Kind == ArchiveItemKind.Folder).ToList() ?? [];
            return _listing;
        }
        catch (HttpRequestException)
        {
            _error = "The archive change could not reach the server.";
            return null;
        }
        finally
        {
            _operationPending = false;
        }
    }

    private async Task HideCreateModalAsync()
    {
        if (_bootstrapModule is null)
        {
            return;
        }

        try
        {
            await _bootstrapModule.InvokeVoidAsync("hideModal", CreateModalId);
        }
        catch (JSException)
        {
        }
    }

    private void CancelDialogs()
    {
        _renaming = null;
        _moving = null;
        _renameName = string.Empty;
        _moveDestinationId = null;
    }

    private static string FileIcon(ArchiveItemDto item) =>
        item.IsVideo ? "bi-film text-primary" : "bi-file-earmark text-body-secondary";

    private static string FormatSize(long? bytes)
    {
        if (bytes is null)
        {
            return string.Empty;
        }

        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var size = (double)Math.Max(0, bytes.Value);
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return unit == 0 ? $"{size:0} {units[unit]}" : $"{size:0.#} {units[unit]}";
    }

    public void Dispose()
    {
        PlayerState.StateChanged -= HandlePlayerStateChanged;
    }

    private sealed class FolderForm
    {
        public string Name { get; set; } = string.Empty;
    }
}
