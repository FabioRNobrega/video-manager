@page "/utilities"

<PageTitle>Utilities · PereneArchive</PageTitle>

<header class="mb-4">
    <h1 class="h3 mb-0">Utilities</h1>
</header>

<div class="d-flex flex-wrap gap-3" role="list" aria-label="Utility apps">
    <a class="card utility-tile text-decoration-none" role="listitem" href="/utilities/video-composition">
        <div class="card-body d-flex flex-column align-items-center justify-content-center text-center gap-2">
            <i class="bi bi-exclude fs-1" aria-hidden="true"></i>
            <span class="fw-semibold">Video Composition</span>
        </div>
    </a>
    <a class="card utility-tile text-decoration-none" role="listitem" href="/utilities/video-cut">
        <div class="card-body d-flex flex-column align-items-center justify-content-center text-center gap-2">
            <i class="bi bi-braces-asterisk fs-1" aria-hidden="true"></i>
            <span class="fw-semibold">VideoCut</span>
        </div>
    </a>
    <a class="card utility-tile text-decoration-none" role="listitem" href="/utilities/image-cutter">
        <div class="card-body d-flex flex-column align-items-center justify-content-center text-center gap-2">
            <i class="bi bi-bounding-box-circles fs-1" aria-hidden="true"></i>
            <span class="fw-semibold">ImageCutter</span>
        </div>
    </a>
</div>
