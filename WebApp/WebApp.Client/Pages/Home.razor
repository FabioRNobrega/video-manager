@page "/"
@inject HttpClient Http
@inject PersistentPlayerState PlayerState
@implements IDisposable

<PageTitle>Videos · PereneArchive</PageTitle>

<header class="mb-4">
    <h1 class="h3 mb-0">Videos</h1>
</header>

<div class="d-flex flex-column mb-3 align-content-between">
    <ArchiveBrowser Category="videos"
                    Title="Videos"
                    Icon="bi-collection-play" />
    <section class="card mt-3 overflow-hidden" aria-labelledby="cuts-heading">
        <div class="card-header d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <div>
                <p class="small fw-bold text-uppercase text-body-secondary mb-0">Cuts</p>
                <h2 id="cuts-heading" class="h5 mb-0">Saved cuts</h2>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (_isPollingCuts)
                {
                    <span class="spinner-border spinner-border-sm text-primary" role="status" aria-label="Saving cut"></span>
                }
                <span class="small text-body-secondary" aria-live="polite">
                    @_selectedCutIds.Count @(_selectedCutIds.Count == 1 ? "clip" : "clips") selected
                </span>
                <button class="btn btn-primary d-inline-flex align-items-center justify-content-center"
                        type="button"
                        disabled="@(_selectedCutIds.Count < 2 || _isCreatingComposition)"
                        @onclick="CreateCompositionAsync">
                    @if (_isCreatingComposition)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="bi bi-collection-play me-2" aria-hidden="true"></i>
                    }
                    Create Composition
                </button>
            </div>
        </div>
        @if (_compositionCreateError is not null)
        {
            <div class="alert alert-danger m-3 mb-0" role="alert">@_compositionCreateError</div>
        }
        <VideoGrid Items="_cuts"
                   HasLoaded="_cutsLoaded"
                   IsLoading="_cutsLoading"
                   Error="@_cutError"
                   SelectedId="@(PlayerState.StreamBasePath == PersistentPlayerState.CutStreamBasePath ? PlayerState.SelectedId : null)"
                   PreviewingVideoId="@_previewingCutId"
                   OnSelect="SelectCut"
                   OnCardMouseEnter="OnCutMouseEnter"
                   OnCardMouseLeave="OnCutMouseLeave"
                   SelectionEnabled="true"
                   SelectedIds="_selectedCutIds"
                   OnToggleSelect="ToggleCutSelection"
                   GridLabel="Saved cuts"
                   SingularLabel="cut"
                   PluralLabel="cuts"
                   LoadingTitle="Loading cuts..."
                   LoadingMessage="Reading saved cuts."
                   ErrorTitle="Cuts failed"
                   NotLoadedIcon="bi-scissors"
                   NotLoadedTitle="Loading saved cuts"
                   NotLoadedMessage="Saved cuts will appear here."
                   EmptyIcon="bi-scissors"
                   EmptyTitle="No cuts saved yet"
                   EmptyMessage="Set A and B points on a library video, then save a cut." />
    </section>

    <section class="card mt-3 overflow-hidden" aria-labelledby="compositions-heading">
        <div class="card-header d-flex align-items-center justify-content-between gap-3">
            <div>
                <p class="small fw-bold text-uppercase text-body-secondary mb-0">Video Compositions</p>
                <h2 id="compositions-heading" class="h5 mb-0">Composed videos</h2>
            </div>
            @if (_isPollingCompositions)
            {
                <span class="spinner-border spinner-border-sm text-primary" role="status" aria-label="Composing video"></span>
            }
        </div>
        @if (_compositionLoadError is not null)
        {
            <div class="alert alert-danger m-3 mb-0" role="alert">@_compositionLoadError</div>
        }
        @{
            var pendingJobs = _compositionJobs.Where(job => job.State != CompositionJobState.Completed).ToList();
        }
        @if (pendingJobs.Count > 0)
        {
            <ul class="list-group list-group-flush border-bottom" aria-live="polite">
                @foreach (var job in pendingJobs)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between gap-2">
                        <span class="text-truncate">Composition job @job.JobId[..8]</span>
                        <span class="badge @BadgeClassFor(job.State)">@job.State</span>
                    </li>
                }
            </ul>
        }
        <VideoGrid Items="_compositions"
                   HasLoaded="_compositionsLoaded"
                   IsLoading="_compositionsLoading"
                   SelectedId="@(PlayerState.StreamBasePath == PersistentPlayerState.CompositionStreamBasePath ? PlayerState.SelectedId : null)"
                   OnSelect="SelectComposition"
                   GridLabel="Video compositions"
                   SingularLabel="composition"
                   PluralLabel="compositions"
                   LoadingTitle="Loading compositions..."
                   LoadingMessage="Reading video compositions."
                   ErrorTitle="Compositions failed"
                   NotLoadedIcon="bi-collection-play"
                   NotLoadedTitle="Loading video compositions"
                   NotLoadedMessage="Composed videos will appear here."
                   EmptyIcon="bi-collection-play"
                   EmptyTitle="No compositions yet"
                   EmptyMessage="Select 2 or more cuts above, then choose Create Composition." />
    </section>
</div>

@code {
    private static readonly TimeSpan PollingInterval = TimeSpan.FromSeconds(2);
    private IReadOnlyList<VideoItemDto> _videos = Array.Empty<VideoItemDto>();
    private IReadOnlyList<VideoItemDto> _cuts = Array.Empty<VideoItemDto>();
    private IReadOnlyList<VideoItemDto> _compositions = Array.Empty<VideoItemDto>();
    private IReadOnlyList<CompositionJobDto> _compositionJobs = Array.Empty<CompositionJobDto>();
    private bool _cutsLoaded;
    private bool _cutsLoading = true;
    private bool _isPollingCuts;
    private bool _compositionsLoaded;
    private bool _compositionsLoading = true;
    private bool _isPollingCompositions;
    private bool _isCreatingComposition;
    private string? _cutError;
    private string? _compositionLoadError;
    private string? _compositionCreateError;
    private string? _previewingCutId;
    private CancellationTokenSource? _pollingCts;
    private CancellationTokenSource? _cutPollingCts;
    private CancellationTokenSource? _cutHoverDelayCts;
    private CancellationTokenSource? _compositionPollingCts;
    private readonly HashSet<string> _selectedCutIds = new(StringComparer.Ordinal);
    private static readonly TimeSpan HoverDelay = TimeSpan.FromMilliseconds(300);

    protected override async Task OnInitializedAsync()
    {
        PlayerState.CutQueued += HandleCutQueued;
        await LoadCutsAsync();
        await LoadCompositionsAsync();
    }

    private void SelectCut(VideoItemDto cut)
    {
        PlayerState.SelectCut(cut);
    }

    private void SelectComposition(VideoItemDto composition)
    {
        PlayerState.SelectComposition(composition);
    }

    private void ToggleCutSelection(string cutId)
    {
        if (!_selectedCutIds.Remove(cutId))
        {
            _selectedCutIds.Add(cutId);
        }
    }

    private async Task CreateCompositionAsync()
    {
        if (_selectedCutIds.Count < 2 || _isCreatingComposition)
        {
            return;
        }

        _isCreatingComposition = true;
        _compositionCreateError = null;

        try
        {
            using var response = await Http.PostAsJsonAsync(
                "api/compositions", new CreateCompositionRequest(_selectedCutIds.ToList()));

            if (!response.IsSuccessStatusCode)
            {
                _compositionCreateError = "The composition could not be created. Try again.";
                return;
            }

            _selectedCutIds.Clear();
            await LoadCompositionJobsAsync();
            StartCompositionPolling();
        }
        catch (HttpRequestException)
        {
            _compositionCreateError = "The composition could not be reached. Try again.";
        }
        finally
        {
            _isCreatingComposition = false;
        }
    }

    private async Task LoadCutsAsync()
    {
        _cutsLoading = true;
        _cutError = null;

        try
        {
            _cuts = await Http.GetFromJsonAsync<List<VideoItemDto>>("api/cuts") ?? [];
            StartCutPollingIfPending();
        }
        catch (HttpRequestException)
        {
            _cutError = "The saved cuts could not be loaded.";
        }
        catch (TaskCanceledException)
        {
            _cutError = "Loading saved cuts was interrupted.";
        }
        finally
        {
            _cutsLoaded = true;
            _cutsLoading = false;
        }
    }

    private void HandleCutQueued()
    {
        StartCutPolling(_cuts.Count);
    }

    private async Task LoadCompositionsAsync()
    {
        _compositionsLoading = true;

        try
        {
            _compositions = await Http.GetFromJsonAsync<List<VideoItemDto>>("api/compositions") ?? [];
            await LoadCompositionJobsAsync();
            StartCompositionPollingIfNeeded();
        }
        catch (HttpRequestException)
        {
            _compositionLoadError = "The saved compositions could not be loaded.";
        }
        catch (TaskCanceledException)
        {
            _compositionLoadError = "Loading video compositions was interrupted.";
        }
        finally
        {
            _compositionsLoaded = true;
            _compositionsLoading = false;
        }
    }

    private async Task LoadCompositionJobsAsync()
    {
        try
        {
            _compositionJobs = await Http.GetFromJsonAsync<List<CompositionJobDto>>("api/compositions/jobs") ?? [];
        }
        catch (HttpRequestException)
        {
        }
    }

    private void OnCutMouseEnter(VideoItemDto item)
    {
        _cutHoverDelayCts?.Cancel();
        _cutHoverDelayCts?.Dispose();
        var cts = new CancellationTokenSource();
        _cutHoverDelayCts = cts;

        _ = ActivateCutPreviewAfterDelayAsync(item, cts);
    }

    private void OnCutMouseLeave()
    {
        _cutHoverDelayCts?.Cancel();
        _cutHoverDelayCts?.Dispose();
        _cutHoverDelayCts = null;

        if (_previewingCutId is not null)
        {
            _previewingCutId = null;
            StateHasChanged();
        }
    }

    private void StartPollingIfPending()
    {
        if (!_videos.Any(video => video.ThumbnailState == ThumbnailState.Pending))
        {
            return;
        }

        var cts = new CancellationTokenSource();
        _pollingCts = cts;
        _ = PollAsync(cts.Token);
    }

    private void StartCutPolling(int previousCount)
    {
        CancelCutPolling();
        _isPollingCuts = true;
        var cts = new CancellationTokenSource();
        _cutPollingCts = cts;
        _ = PollCutsAsync(previousCount, cts.Token);
    }

    private void StartCutPollingIfPending()
    {
        if (!HasPendingGeneratedAssets(_cuts))
        {
            return;
        }

        StartCutPolling(_cuts.Count);
    }

    private void StartCompositionPolling()
    {
        CancelCompositionPolling();
        _isPollingCompositions = true;
        var cts = new CancellationTokenSource();
        _compositionPollingCts = cts;
        _ = PollCompositionsAsync(cts.Token);
    }

    private void StartCompositionPollingIfNeeded()
    {
        if (HasNonTerminalJobs(_compositionJobs))
        {
            StartCompositionPolling();
        }
    }

    private async Task PollCompositionsAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(PollingInterval, cancellationToken);

                List<CompositionJobDto>? jobs;
                List<VideoItemDto>? items;
                try
                {
                    jobs = await Http.GetFromJsonAsync<List<CompositionJobDto>>("api/compositions/jobs", cancellationToken);
                    items = await Http.GetFromJsonAsync<List<VideoItemDto>>("api/compositions", cancellationToken);
                }
                catch (HttpRequestException)
                {
                    _isPollingCompositions = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                if (cancellationToken.IsCancellationRequested || jobs is null || items is null)
                {
                    return;
                }

                _compositionJobs = jobs;
                _compositions = items;
                _compositionsLoaded = true;

                if (PlayerState.Selected is not null && PlayerState.StreamBasePath == PersistentPlayerState.CompositionStreamBasePath)
                {
                    var selected = items.FirstOrDefault(item => item.Id == PlayerState.Selected.Id);
                    if (selected is not null)
                    {
                        PlayerState.UpdateSelected(selected);
                    }
                }

                await InvokeAsync(StateHasChanged);

                if (!HasNonTerminalJobs(jobs))
                {
                    _isPollingCompositions = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private static bool HasNonTerminalJobs(IReadOnlyList<CompositionJobDto> jobs) =>
        jobs.Any(job => job.State is CompositionJobState.Pending or CompositionJobState.Processing);

    private static string BadgeClassFor(CompositionJobState state) => state switch
    {
        CompositionJobState.Pending => "text-bg-secondary",
        CompositionJobState.Processing => "text-bg-primary",
        CompositionJobState.Failed => "text-bg-danger",
        _ => "text-bg-success"
    };

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(PollingInterval, cancellationToken);

                List<VideoItemDto>? updated;
                try
                {
                    updated = await Http.GetFromJsonAsync<List<VideoItemDto>>("api/videos", cancellationToken);
                }
                catch (HttpRequestException)
                {
                    return;
                }

                if (cancellationToken.IsCancellationRequested || updated is null)
                {
                    return;
                }

                _videos = updated;
                if (PlayerState.Selected is not null && PlayerState.StreamBasePath == PersistentPlayerState.VideoStreamBasePath)
                {
                    var selected = updated.FirstOrDefault(video => video.Id == PlayerState.Selected.Id);
                    if (selected is not null)
                    {
                        PlayerState.UpdateSelected(selected);
                    }
                }

                await InvokeAsync(StateHasChanged);

                if (!updated.Any(video => video.ThumbnailState == ThumbnailState.Pending))
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PollCutsAsync(int previousCount, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(PollingInterval, cancellationToken);

                List<VideoItemDto>? updated;
                try
                {
                    updated = await Http.GetFromJsonAsync<List<VideoItemDto>>("api/cuts", cancellationToken);
                }
                catch (HttpRequestException)
                {
                    _isPollingCuts = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                if (cancellationToken.IsCancellationRequested || updated is null)
                {
                    return;
                }

                _cuts = updated;
                _cutsLoaded = true;

                if (PlayerState.Selected is not null && PlayerState.StreamBasePath == PersistentPlayerState.CutStreamBasePath)
                {
                    var selected = updated.FirstOrDefault(video => video.Id == PlayerState.Selected.Id);
                    if (selected is not null)
                    {
                        PlayerState.UpdateSelected(selected);
                    }
                }

                if (updated.Count > previousCount)
                {
                    previousCount = updated.Count;
                }

                if (!HasPendingGeneratedAssets(updated))
                {
                    _isPollingCuts = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task ActivateCutPreviewAfterDelayAsync(VideoItemDto item, CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(HoverDelay, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        if (item.HoverPreviewState != HoverPreviewState.Ready || string.IsNullOrEmpty(item.HoverPreviewUrl))
        {
            return;
        }

        _previewingCutId = item.Id;
        await InvokeAsync(StateHasChanged);
    }

    private static bool HasPendingGeneratedAssets(IReadOnlyList<VideoItemDto> items) =>
        items.Any(item => item.ThumbnailState == ThumbnailState.Pending || item.HoverPreviewState == HoverPreviewState.Pending);

    private void CancelPolling()
    {
        _pollingCts?.Cancel();
        _pollingCts?.Dispose();
        _pollingCts = null;
    }

    private void CancelCutPolling()
    {
        _cutPollingCts?.Cancel();
        _cutPollingCts?.Dispose();
        _cutPollingCts = null;
    }

    private void CancelCompositionPolling()
    {
        _compositionPollingCts?.Cancel();
        _compositionPollingCts?.Dispose();
        _compositionPollingCts = null;
    }

    private void CancelCutHover()
    {
        _cutHoverDelayCts?.Cancel();
        _cutHoverDelayCts?.Dispose();
        _cutHoverDelayCts = null;
    }

    public void Dispose()
    {
        PlayerState.CutQueued -= HandleCutQueued;
        CancelPolling();
        CancelCutPolling();
        CancelCutHover();
        CancelCompositionPolling();
    }
}
