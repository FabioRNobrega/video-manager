@inherits LayoutComponentBase

<div class="vh-100 bg-body-tertiary d-flex flex-column overflow-hidden p-0 p-md-4">
    <a class="visually-hidden-focusable btn btn-primary position-fixed top-0 start-0 z-3 m-2"
       href="#main-content">Skip to main content</a>
    <div class="d-flex flex-column flex-md-row flex-fill min-h-0 overflow-hidden bg-body-tertiary">
        <Sidebar />
        <main id="main-content" class="flex-fill min-w-0 min-h-0 overflow-y-auto scrollbar-none-mobile m-2 m-md-0 px-3 px-md-4 py-4 bg-body border rounded-4 shadow-sm">@Body</main>
    </div>
</div>

<div id="blazor-error-ui"
     class="alert alert-warning position-fixed bottom-0 start-0 z-3 w-100 rounded-0 mb-0 py-2 px-3"
     style="display: none"
     role="alert"
     data-nosnippet>
    <strong>Something went wrong.</strong>
    <a href="." class="alert-link ms-1">Reload PereneArchive</a>
    <button type="button"
            class="btn-close position-absolute top-50 end-0 translate-middle-y me-2"
            aria-label="Dismiss error"></button>
</div>
